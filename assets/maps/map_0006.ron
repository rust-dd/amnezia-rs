]),(code:20110,indent:0,string:"\"Jó napot uram! Miben segíthetek?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Munkát keresek, és a fogadós hölgy",params:[]),(code:20110,indent:0,string:"azt mondta, hogy itt biztos kapok.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Értem. Mi a foglalkozása?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Zsoldos vagyok.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Rendben. Jelenleg két munka vár megoldásra,",params:[]),(code:20110,indent:0,string:"mindkettőért 200 GP-t tudunk fizetni.",params:[]),(code:10110,indent:0,string:"Az egyik feladat az lenne, hogy keresse meg és",params:[]),(code:20110,indent:0,string:"tegye ártalmatlanná azt a rablóbandát, ami a",params:[]),(code:20110,indent:0,string:"kereskedőinket zaklatja. Egy bűnöző sem maradhat",params:[]),(code:20110,indent:0,string:"életben.",params:[]),(code:10110,indent:0,string:"A másik pedig, hogy fogja el azt az elvetemült",params:[]),(code:20110,indent:0,string:"tolvajt, aki minden éjjel lopja a gabonánkat a",params:[]),(code:20110,indent:0,string:"raktárból. Melyiket vállalja?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Rablóbanda likvidálás/Tolvajfogás/Egyik se",params:[3]),(code:20140,indent:0,string:"Rablóbanda likvidálás",params:[0]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Rendben. Az előző mészárlás túlélője azt mondja,",params:[]),(code:20110,indent:1,string:"hogy 20-an vannak. Ölje meg mindet! Előlegben",params:[]),(code:20110,indent:1,string:"50 GP-t tudunk fizetni.\"",params:[]),(code:10310,indent:1,string:"",params:[0,0,50]),(code:11550,indent:1,string:"Holy1",params:[90,150,50]),(code:10110,indent:1,string:"\\N[1] kapott 50 GP-t!",params:[]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Ha az értesüléseink helyesek, akkor a közeli",params:[]),(code:20110,indent:1,string:"barlangba vetették be magukat.\"",params:[]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Hozzon valami bizonyítékot, hogy mindenkit",params:[]),(code:20110,indent:1,string:"megölt!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"És mi legyen az? A skalpjukat nem",params:[]),(code:20110,indent:1,string:"vágom le!\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Ez nem is szükséges. A rablóvezér elrabolt egy",params:[]),(code:20110,indent:1,string:"vörös színű rubinmedált. Ezt hozza vissza, és",params:[]),(code:20110,indent:1,string:"akkor tudjuk, hogy elvégezte a feladatot!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Rendben.\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10210,indent:1,string:"",params:[0,26,26,0]),(code:10210,indent:1,string:"",params:[0,24,24,0]),(code:10210,indent:1,string:"",params:[0,22,22,1]),(code:11330,indent:1,string:"",params:[10001,8,0,0,2]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Tolvajfogás",params:[1]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Rendben. A fickó mindig éjszaka lop a raktárból,",params:[]),(code:20110,indent:1,string:"és nem tudjuk, hogy hogyan jut be. Itt a kulcs,",params:[]),(code:20110,indent:1,string:"menjen be a raktárba, és kapja el a tolvajt!\"",params:[]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Ameddig szabadon garázdálkodik, addig",params:[]),(code:20110,indent:1,string:"kénytelenek vagyunk Tyranból megrendelni",params:[]),(code:20110,indent:1,string:"a szükséges gabona egy részét...\"",params:[]),(code:10320,indent:1,string:"",params:[0,0,135,0,1]),(code:11550,indent:1,string:"Item",params:[90,100,50]),(code:10110,indent:1,string:"\\N[1] megkapta a raktár kulcsát!",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Oké.\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10210,indent:1,string:"",params:[0,47,47,0]),(code:10210,indent:1,string:"",params:[0,26,26,0]),(code:11330,indent:1,string:"",params:[10001,8,0,0,2]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Egyik se",params:[2]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Értem. De ne feledje, ha nem dönt hamar, akkor",params:[]),(code:20110,indent:1,string:"más megelőzheti...\"",params:[]),(code:10210,indent:1,string:"",params:[0,23,23,0]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:23,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Na, sikerült eldönteni? Melyiket vállalja?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Rablóbanda likvidálás/Tolvajfogás/Egyik se",param