]",params:[]),(code:20110,indent:1,string:"\"Oké.\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10210,indent:1,string:"",params:[0,47,47,0]),(code:10210,indent:1,string:"",params:[0,26,26,0]),(code:11330,indent:1,string:"",params:[10001,8,0,0,2]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Egyik se",params:[2]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Még mindig nem sikerült választani? Kifut az",params:[]),(code:20110,indent:1,string:"időből...\"",params:[]),(code:10210,indent:1,string:"",params:[0,23,23,0]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:24,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Na? Megvan a medál?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Még nincs...\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Akkor meg ne ácsorogjon itt!\"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:47,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Tudni akar még valamit?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Nem.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Akkor meg ne ácsorogjon itt!\"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:8,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:128,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Elvégezte a feladatot?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[7,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Igen. Itt a medál.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10320,indent:0,string:"",params:[1,0,128,0,1]),(code:10110,indent:0,string:"\\N[1] odaadta a medált.",params:[]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Ó! Remek!\"",params:[]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Itt a bére!\"",params:[]),(code:10310,indent:0,string:"",params:[0,0,150]),(code:11550,indent:0,string:"Holy1",params:[90,150,50]),(code:10110,indent:0,string:"\\N[1] kapott 150 GP-t!",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Köszönöm!\"",params:[]),(code:10210,indent:0,string:"",params:[0,28,28,0]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:52,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Nos? Hol van a tolvaj?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Sajnos elmenekült, de a járatot",params:[]),(code:20110,indent:0,string:"eltorlaszoltam. Többet nem tud lopni.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hmmm... Mivel a tolvaj megszökött, így csak",params:[]),(code:20110,indent:0,string:"100 GP-t tudok fizetni. Kérem adja vissza a",params:[]),(code:20110,indent:0,string:"raktárkulcsot!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Tessék.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10320,indent:0,string:"",params:[1,0,135,0,1]),(code:10110,indent:0,string:"\\N[1] visszaadta a raktárkulcsot.",params:[]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Köszönöm. Itt a pénze.\"",params:[]),(code:10310,indent:0,string:"",params:[0,0,100]),(code:11550,indent:0,string:"Holy1",params:[90,150,50]),(code:10110,indent:0,string:"\\N[1] kapott 100 GP-t!",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Köszönöm.\"",params:[]),(code:10210,indent:0,string:"",params:[0,28,28,0]),(code:10210,indent:0,string:"",params:[0,22,22,1]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:60,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Nos? Megvan a tolvaj?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Igen, de meghalt... Nekem támadt, és",params:[]),(code:20110,indent:0,string:"muszáj volt megvédenem magam...\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Végülis egyre megy, a lényeg, hogy a lopás",params:[]),(code:20110,indent:0,string:"ne folytatódjon.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Az nem fog... Ezen kívül megtaláltam",params:[]),(code:20110,indent:0,string:"az ellopott gabonát is. Egy házban",params:[]),(code:20110,indent:0,string:"vannak elraktározva Toran mellett.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Hmmm, ez egészen különleges eredmény!",params:[]),(code:20110,indent:0,string:"Megérdemel egy kis prémiumot!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[7,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Köszönöm!\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Nincs mit. Kérem, adja vissza",params:[]),(code:20110,indent:0,string:"a raktárkulcsot!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Ó, hogyne. Tessék.\"",params:[]),(code:10320,indent:0,string:"",params:[1,0,135,0,1]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"\\N[1] visszaadta a raktárkulcsot.",params:[]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Köszönöm! Itt a fizetsége.\"",params:[]),(code:10310,indent:0,string:"",params:[0,0,350]),(code:11550,indent:0,string:"Holy1",params:[90,150,50]),(code:10110,indent:0,string:"\\N[1] kapott 350 GP-t!",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Köszönöm.\"",params:[]),(code:10210,indent:0,string:"",params:[0,61,61,1]),(code:10210,indent:0,string:"",params:[0,28,28,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:28,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Mára nincs több feladat.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"És... A másik munka?\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Ja, azt már elvégezte más.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Aha.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:71,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Most nincsen semmilyen munkánk.\"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:11,x:10,y:7,name:"EV0011",pages:[(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Jó napot uram! Miben segíthetek?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Munkát keresek, és a fogadós hölgy",params:[]),(code:20110,indent:0,string:"azt mondta, hogy itt biztos kapok.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Értem. Mi a foglalkozása?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Zsoldos vagyok.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Rendben. Jelenleg két munka vár megoldásra,",params:[]),(code:20110,indent:0,string:"mindkettőért 200 GP-t tudunk fizetni.",params:[]),(code:10110,indent:0,string:"Az egyik feladat az lenne, hogy keresse meg és",params:[]),(code:20110,indent:0,string:"tegye ártalmatlanná azt a rablóbandát, ami a",params:[]),(code:20110,indent:0,string:"kereskedőinket zaklatja. Egy bűnöző sem maradhat",params:[]),(code:20110,indent:0,string:"életben.",params:[]),(code:10110,indent:0,string:"A másik pedig, hogy fogja el azt az elvetemült",params:[]),(code:20110,indent:0,string:"tolvajt, aki minden éjjel lopja a gabonánkat a",params:[]),(code:20110,indent:0,string:"raktárból. Melyiket vállalja?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Rablóbanda likvidálás/Tolvajfogás/Egyik se",params:[3]),(code:20140,indent:0,string:"Rablóbanda likvidálás",params:[0]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Rendben. Az előző mészárlás túlélője azt mondja,",params:[]),(code:20110,indent:1,string:"hogy 20-an vannak. Ölje meg mindet! Előlegben",params:[]),(code:20110,indent:1,string:"50 GP-t tudunk fizetni.\"",params:[]),(code:10310,indent:1,string:"",params:[0,0,50]),(code:11550,indent:1,string:"Holy1",params:[90,150,50]),(code:10110,indent:1,string:"\\N[1] kapott 50 GP-t!",params:[]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Ha az értesüléseink helyesek, akkor a közeli",params:[]),(code:20110,indent:1,string:"barlangba vetették be magukat.\"",params:[]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Hozzon valami bizonyítékot, hogy mindenkit",params:[]),(code:20110,indent:1,string:"megölt!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"És mi legyen az? A skalpjukat nem",params:[]),(code:20110,indent:1,string:"vágom le!\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Ez nem is szükséges. A rablóvezér elrabolt egy",params:[]),(code:20110,indent:1,string:"vörös színű rubinmedált. Ezt hozza vissza, és",params:[]),(code:20110,indent:1,string:"akkor tudjuk, hogy elvégezte a feladatot!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Rendben.\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10210,indent:1,string:"",params:[0,26,26,0]),(code:10210,indent:1,string:"",params:[0,24,24,0]),(code:10210,indent:1,string:"",params:[0,22,22,1]),(code:11330,indent:1,string:"",params:[10001,8,0,0,2]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Tolvajfogás",params:[1]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Rendben. A fickó mindig éjszaka lop a raktárból,",params:[]),(code:20110,indent:1,string:"és nem tudjuk, hogy hogyan jut be. Itt a kulcs,",params:[]),(code:20110,indent:1,string:"menjen be a raktárba, és kapja el a tolvajt!\"",params:[]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Ameddig szabadon garázdálkodik, addig",params:[]),(code:20110,indent:1,string:"kénytelenek vagyunk Tyranból megrendelni",params:[]),(code:20110,indent:1,string:"a szükséges gabona egy részét...\"",params:[]),(code:10320,indent:1,string:"",params:[0,0,135,0,1]),(code:11550,indent:1,string:"Item",params:[90,100,50]),(code:10110,indent:1,string:"\\N[1] megkapta a raktár kulcsát!",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Oké.\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10210,indent:1,string:"",params:[0,47,47,0]),(code:10210,indent:1,string:"",params:[0,26,26,0]),(code:11330,indent:1,string:"",params:[10001,8,0,0,2]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Egyik se",params:[2]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Intéző",params:[]),(code:20110,indent:1,string:"\"Értem. De ne feledje, ha nem dönt hamar, akkor",params:[]),(code:20110,indent:1,string:"más megelőzheti...\"",params:[]),(code:10210,indent:1,string:"",params:[0,23,23,0]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:23,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Intéző",params:[]),(code:20110,indent:0,string:"\"Na, sikerült eldönteni? Melyiket vállalja?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Rabl