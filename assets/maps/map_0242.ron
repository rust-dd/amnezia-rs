ic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"Jé, egy vásárló! Üdv!\"",params:[]),(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"Miben segíthetek?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Miféle bolt ez?\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"Páncélbolt. De nem a szokásos értelemben.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"???\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"Mi nem árulunk előre elkészített páncélokat.\"",params:[]),(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"A vevő megrendelése alapján dolgozunk.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hmmm...\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"Sőt mi több, mágikus páncélokat is tudunk",params:[]),(code:20110,indent:0,string:"készíteni!\"",params:[]),(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"Ha van önnél valamilyen drágakő, akkor a",params:[]),(code:20110,indent:0,string:"kőért cserébe készítünk egy olyan páncélt, ami",params:[]),(code:20110,indent:0,string:"az adott ékkő tulajdonságait hordozza magában.\"",params:[]),(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"Például a gyémántpáncélok a legerősebb",params:[]),(code:20110,indent:0,string:"páncélok a világon, a rubinpáncélok viszont",params:[]),(code:20110,indent:0,string:"védik a viselőjét az elemi támadásoktól.\"",params:[]),(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"Ha érdekli a dolog, akkor fáradjon oda",params:[]),(code:20110,indent:0,string:"Shame-hez, ő készíti a páncélokat.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Rendben.\"",params:[]),(code:10210,indent:0,string:"",params:[0,519,519,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:519,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Gobleen",params:[]),(code:20110,indent:0,string:"\"A páncélkészítést Shame végzi...\"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:8,x:6,y:13,name:"EV0008",pages:[(trigger:1,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:0,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:11520,indent:0,string:"",params:[2000]),(code:11330,indent:0,string:"",params:[10001,8,0,0,14]),(code:11550,indent:0,string:"Door2",params:[90,50,50]),(code:11410,indent:0,string:"",params:[1]),(code:10810,indent:0,string:"",params:[241,10,8]),(code:11510,indent:0,string:"(OFF)",params:[0,0,100,50]),(code:0,indent:0,string:"",params:[])])])])