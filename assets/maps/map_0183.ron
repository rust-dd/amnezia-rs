",params:[10001,8,0,0,0,3,3,0]),(code:11410,indent:0,string:"",params:[10]),(code:10130,indent:0,string:"Ron",params:[4,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Tif...\"",params:[]),(code:11330,indent:0,string:"",params:[10005,8,0,0,13]),(code:11410,indent:0,string:"",params:[1]),(code:11330,indent:0,string:"",params:[10005,8,0,0,14]),(code:10130,indent:0,string:"Tiffany",params:[4,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Nem tudom magam túltenni",params:[]),(code:20110,indent:0,string:"rajta...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Pedig nagyon szeretném... De...",params:[]),(code:20110,indent:0,string:"Nem megy...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Nem tudom elhinni rólad, hogy",params:[]),(code:20110,indent:0,string:"gyilkos vagy... Még akkor se, ha",params:[]),(code:20110,indent:0,string:"a tények e mellett szólnak...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Te nem lehetsz gyilkos...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[4,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Tif...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[4,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Próbálj meg emlékezni... Vagy...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Próbáljunk meg együtt emlékezni...",params:[]),(code:20110,indent:0,string:"Talán úgy sikerül...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[4,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Nem fog sikerülni...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[4,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"De legalább próbáljuk meg...",params:[]),(code:20110,indent:0,string:"Kérlek...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[4,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Rendben...\"",params:[]),(code:11510,indent:0,string:"Truth",params:[0,90,100,50]),(code:11010,indent:0,string:"",params:[17]),(code:11030,indent:0,string:"",params:[0,0,0,0,0,1]),(code:11020,indent:0,string:"",params:[0]),(code:11410,indent:0,string:"",params:[10]),(code:11310,indent:0,string:"",params:[0]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10120,indent:0,string:"",params:[1,0,0,1]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,indent:0,string:"\"\\N[1]...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,indent:0,string:"\"Emlékszel arra a napra, amikor a katonák",params:[]),(code:20110,indent:0,string:"bejöttek a falunkba?...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\\| Nem...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,indent:0,string:"\"Próbálj meg...\\| Próbálj meg emlékezni...\\|",params:[]),(code:20110,indent:0,string:"Ne add fel ilyen könnyen...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,indent:0,string:"\"Milyen idő volt akkoriban?\\| Hátha erre",params:[]),(code:20110,indent:0,string:"emlékszel...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\\| Hideg...\\| Aznap elég hideg volt...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,indent:0,string:"\"Igen!\\| Gondolkozz tovább!\\|",params:[]),(code:20110,indent:0,string:"Hátha előjönnek az emlékek...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Én éppen valahol falun kívül voltam, hogy",params:[]),(code:20110,indent:0,string:"tüzelőt keressek...\"\\|\\^",params:[]),(code:10810,indent:0,string:"",params:[201,1,8]),(code:11030,indent:0,string:"",params:[100,100,100,0,20,0]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Igen...\\| Emlékszem...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mivel előző nap hatalmas zivatar volt, ezért",params:[]),(code:20110,indent:0,string:"csak vizes fát találtam, és abból is keveset...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Már azon voltam, hogy hazamegyek egy",params:[]),(code:20110,indent:0,string:"baltáért, amikor kiáltásokat hallottam a",params:[]),(code:20110,indent:0,string:"faluból...\"\\|\\^",params:[]),(code:11030,indent:0,string:"",params:[0,0,0,0,20,1]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,indent:0,string:"\"Ez az!\\| Látod, hogy emlékszel...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,indent:0,string:"\"Mi történt ezután?...\"\\|\\^",params:[]),(code:10810,indent:0,string:"",params:[200,6,15]),(code:11030,indent:0,string:"",params:[100,100,100,0,20,0]),(code:11410,indent:0,string:"",params:[10]),(code:11060,indent:0,string:"",params:[2,1,30,4,0]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Vissza...\\| Visszarohantam a faluba, de elkéstem...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mindenki meghalt...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"A szüleid holttestei mellett egy harcos",params:[]),(code:20110,indent:0,string:"állt...\\| Én...\\| Megtámadtam, mert elöntött",params:[]),(code:20110,indent:0,string:"az indulat, és...\\| És megöltem...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"De a szüleidet nem én öltem meg, hidd el!...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,indent:0,string:"\"...\\| Elhiszem...\\| De én miért láttam úgy, mintha",params:[]),(code:20110,indent:0,string:"te állnál ott véres pengékkel a szüleim",params:[]),(code:20110,indent:0,string:"fölött?...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mert én álltam ott...\\| Miután megöltem a harcost,",params:[]),(code:20110,indent:0,string:"odamentem megnézni a szüleidet, de egy hangot",params:[]),(code:20110,indent:0,string:"hallottam, és előkaptam a fegyvereimet megint...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Te pont ekkor láttál meg...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Miközben megpróbáltam elmagyarázni,",params:[]),(code:20110,indent:0,string:"hogy mi történt, valaki mögéd lopakodott, és...\\|",params:[]),(code:20110,indent:0,string:"És hátbaszúrt...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Semmit se tudtam tenni...\\| Pedig...\\| Ha elég",params:[]),(code:20110,indent:0,string:"gyors vagyok...\"\\|\\^",params:[]),(code:10110,indent:0,string:"\\S[5]\\N[1]",params:[]),(code:20110,indent:0,string:"\"Legalább téged megmenthettelek volna...\"\\|\\^",params:[]),(code:11410,indent:0,string:"",params:[20]),(code:10110,indent:0,string:"\\S[5]Tiffany",params:[]),(code:20110,in