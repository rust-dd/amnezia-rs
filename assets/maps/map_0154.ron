0,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Belelapozok/Nem érdekel",params:[2]),(code:20140,indent:0,string:"Belelapozok",params:[0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"No lássuk...\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"-- Cycto Klonarine --",params:[]),(code:20110,indent:1,string:"Lázcsillapító, akár 42 fokos lázat is képes sima",params:[]),(code:20110,indent:1,string:"hőemelkedéssé enyhíteni. Vízben elkeverve kell",params:[]),(code:20110,indent:1,string:"megitatni a beteggel.",params:[]),(code:10110,indent:1,string:"Nagyon erős szer, fontos, hogy csak magas",params:[]),(code:20110,indent:1,string:"lázra szabad beadni, hőemelkedésre nem!",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Ennyi elég volt...",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"-- Benthol Surin --",params:[]),(code:20110,indent:2,string:"Fertőtlenítő szer. Alkalmas bármilyen fertőzés",params:[]),(code:20110,indent:2,string:"enyhítésére, sebek letisztítására. Közvetlenül a",params:[]),(code:20110,indent:2,string:"friss sebre kenve fejti ki hatását leginkább.",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Ennyi elég volt...",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Ennyi elég volt...",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"-- Neoldechron --",params:[]),(code:20110,indent:2,string:"Meghűlés elleni tabletta. A betegnek naponta",params:[]),(code:20110,indent:2,string:"3 darabot kell bevennie, reggeli, ebéd és vacsora",params:[]),(code:20110,indent:2,string:"után. 3 nap alatt elmúlasztja a betegséget.",params:[]),(code:10110,indent:2,string:"Amennyiben a betegség nem enyhül, sürgősen",params:[]),(code:20110,indent:2,string:"antibiotikumot kell adni a betegnek, mert az",params:[]),(code:20110,indent:2,string:"állapota súlyosbodik!",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Ennyi elég volt...",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Ennyi elég volt...",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:12010,indent:2,string:"",params:[0,594,1,0,0,0]),(code:10220,indent:3,string:"",params:[0,15,15,1,0,1,0]),(code:10210,indent:3,string:"",params:[0,594,594,0]),(code:10,indent:3,string:"",params:[]),(code:22011,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"-- Choriadna --",params:[]),(code:20110,indent:2,string:"Ez a szer minimálisra csökkenti a test",params:[]),(code:20110,indent:2,string:"életfunkcióit. Segítségével megakadályozható, hogy",params:[]),(code:20110,indent:2,string:"egy beteg állapota rosszabbodjon.",params:[]),(code:10110,indent:2,string:"Az első adagot meg kell itatni a beteggel",params:[]),(code:20110,indent:2,string:"(azonnal hat!), és utána infúzióban kell tovább",params:[]),(code:20110,indent:2,string:"adagolni, különben a hatása 8 órán belül elmúlik!",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Ennyi elég volt...",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Ennyi elég volt...",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"-- Pronchain Chemolon --",params:[]),(code:20110,indent:2,string:"Fájdalomcsillapító. Testi fájdalmak enyhítésére",params:[]),(code:20110,indent:2,string:"kíváló. Figyelem, alkohollal TILOS keverni, mert",params:[]),(code:20110,indent:2,string:"teljesen kiüti az embert!",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Ennyi elég volt...",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Ennyi elég volt...",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"-- Bitrobon --",params:[]),(code:20110,indent:2,string:"Antibiotikum gyulladások csökkentésére. Naponta",params:[]),(code:20110,indent:2,string:"egy kávéskanálnyit szabad csak bevenni, minden",params:[]),(code:20110,indent:2,string:"reggel.",params:[]),(code:10110,indent:2,string:"Figyelem, nagyon erős hatású szer, rendszeres",params:[]),(code:20110,indent:2,string:"használata függőséghez vezethet!",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"(No, ezekből elég volt ennyi...)\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Ennyi elég volt...",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Nem érdekel",params:[1]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:12110,indent:0,string:"",params:[100]),(code:0,indent:0,string:"",params:[])])])])