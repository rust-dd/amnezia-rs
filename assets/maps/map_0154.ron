n van, és...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[4,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Valahol biztos él még egy-két",params:[]),(code:20110,indent:0,string:"példány...\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Igen. A pletykák szerint a közeli",params:[]),(code:20110,indent:0,string:"hegyen nő egy pár, de senki se",params:[]),(code:20110,indent:0,string:"merte megközelíteni őket...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Miért?\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"A kísértettorony miatt...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[5,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Kísértettorony???\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Igen... Tudni kell, hogy a növény",params:[]),(code:20110,indent:0,string:"csak éjszaka mutatja meg magát...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Hmmm... Várjunk csak!",params:[]),(code:20110,indent:0,string:"Mi a neve?\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Sátángyökér...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[5,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"A... A tiltott növény???\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Igen...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Tiltott növény? Miért? Még",params:[]),(code:20110,indent:0,string:"nem hallottam róla...\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Ennek a növénynek a nedvéből lehet",params:[]),(code:20110,indent:0,string:"elkészíteni a \"Krízis\" nevű mérget...",params:[]),(code:20110,indent:0,string:"Azt, ami megőrjíti az áldozatot...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"De... Akkor hogyan használjuk",params:[]),(code:20110,indent:0,string:"úgy, hogy Tray-nek ne legyen baja?\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Nagyon óvatosnak kell lennünk,",params:[]),(code:20110,indent:0,string:"és a nedvet csakis a parazitára szabad",params:[]),(code:20110,indent:0,string:"rácsöpögtetnünk... Különben...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Tray is meghal...\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Igen...\"",params:[]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"\\N[1]! A gyökér nélkül semmi",params:[]),(code:20110,indent:0,string:"esély arra, hogy Tray túlélje a",params:[]),(code:20110,indent:0,string:"parazita támadását...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Felmegyünk érte...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Várjunk estig, és akkor",params:[]),(code:20110,indent:0,string:"indulunk...\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Ööö... Éjszaka állítólag nagyon",params:[]),(code:20110,indent:0,string:"veszélyes arrafelé járkálni...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Értem... Akkor talán... Menjünk fel",params:[]),(code:20110,indent:0,string:"most, és várjuk meg fennt az éjszakát!",params:[]),(code:20110,indent:0,string:"Így nem kell mászkálnunk éjjel...\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Igen... Ez egész jó ötlet...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Helyes! Akkor ezt tesszük! \\N[1],",params:[]),(code:20110,indent:0,string:"válassz csapatot!\"",params:[]),(code:11010,indent:0,string:"",params:[0]),(code:11960,indent:0,string:"",params:[0]),(code:11310,indent:0,string:"",params:[0]),(code:10210,indent:0,string:"",params:[0,374,374,0]),(code:10210,indent:0,string:"",params:[0,304,304,1]),(code:10210,indent:0,string:"",params:[0,373,373,0]),(code:10220,indent:0,string:"",params:[0,47,47,0,0,1,0]),(code:11410,indent:0,string:"",params:[1]),(code:10810,indent:0,string:"",params:[118,3,4]),(code:11510,indent:0,string:"PartySelect",params:[0,90,100,50]),(code:11020,indent:0,string:"",params:[0]),(code:10210,indent:0,string:"",params:[0,6,6,1]),(code:10210,indent:0,string:"",params:[0,372,372,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"Chara2",graphic_index:2,direction:3,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:tr