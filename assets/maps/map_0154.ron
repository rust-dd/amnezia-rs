30,indent:0,string:"Chara1",params:[2,0,0]),(code:10110,indent:0,string:"Tray",params:[]),(code:20110,indent:0,string:"\"Ne... Nincs pofám csak úgy",params:[]),(code:20110,indent:0,string:"faképnél hagyni titeket, azok után,",params:[]),(code:20110,indent:0,string:"hogy megmentettek.\"",params:[]),(code:10110,indent:0,string:"Tray",params:[]),(code:20110,indent:0,string:"\"Veletek tartok egy darabig, hátha",params:[]),(code:20110,indent:0,string:"tudok segíteni valamiben.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Oké. Valószínűleg szükségünk lesz",params:[]),(code:20110,indent:0,string:"a harci tudásodra...\"",params:[]),(code:10130,indent:0,string:"Chara1",params:[2,0,0]),(code:10110,indent:0,string:"Tray",params:[]),(code:20110,indent:0,string:"\"Miért, meg akartok ölni valakit?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Nem... Legalábbis egyenlőre...",params:[]),(code:20110,indent:0,string:"Pontosabban nem tudom.\"",params:[]),(code:10130,indent:0,string:"Chara1",params:[2,0,0]),(code:10110,indent:0,string:"Tray",params:[]),(code:20110,indent:0,string:"\"???\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mindegy, először menjünk el",params:[]),(code:20110,indent:0,string:"Stern-be, aztán majd meglátjuk...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Jól van.\"",params:[]),(code:10130,indent:0,string:"Stella",params:[0,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Ha szükségetek van egy orvosra, akkor",params:[]),(code:20110,indent:0,string:"én is szívesen veletek tartok...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[1,0,0]),