[(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Har, \\N[1]! Mi a helyzet?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Semmi különös... Stan, kérdeznék",params:[]),(code:20110,indent:0,string:"valamit...\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Har! Csak rajta!\"",params:[]),(code:11010,indent:0,string:"",params:[0]),(code:11310,indent:0,string:"",params:[0]),(code:10810,indent:0,string:"",params:[125,8,12]),(code:10210,indent:0,string:"",params:[0,319,319,0]),(code:11410,indent:0,string:"",params:[1]),(code:11020,indent:0,string:"",params:[0]),(code:0,indent:0,string:"",params:[])]),(trigger:3,graphic_name:"Chara2",graphic_index:4,direction:1,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:319,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hogy kerültetek ide? Hogy",params:[]),(code:20110,indent:0,string:"találtátok meg a léghajót?\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Har, az egy hosszú történet. Szóval.",params:[]),(code:20110,indent:0,string:"Miután elsüllyedt a hajó, és mi vízbe vetettük",params:[]),(code:20110,indent:0,string:"magunkat, találkoztunk egy halászbárkával.\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"A halászok felvettek minket, és egy kisebb",params:[]),(code:20110,indent:0,string:"hajókázás után kitettek Tyran mellett.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"És a léghajó már ott volt?\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Várj, most jön a lényeg! Egy barlangban",params:[]),(code:20110,indent:0,string:"húztuk meg magunkat, és egyik nap",params:[]),(code:20110,indent:0,string:"reggel tájban egy furcsa dolgot láttunk.\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"A léghajó volt az, amint lefelé zuhant. Ám",params:[]),(code:20110,indent:0,string:"hirtelen lelassult a zuhanása, és pár perccel",params:[]),(code:20110,indent:0,string:"később simán földet ért az erdőben.\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Persze marha kíváncsiak voltunk, hogy mi",params:[]),(code:20110,indent:0,string:"az, ezért odamentünk.\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"A legnagyobb meglepetés csak ezután jött,",params:[]),(code:20110,indent:0,string:"ugyanis a léghajó üres volt! Mindannyian",params:[]),(code:20110,indent:0,string:"benyomultunk, de senkit se találtunk.\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Már éppen el akartunk menni, amikor egy",params:[]),(code:20110,indent:0,string:"fekete ruhás fickót láttunk bejönni. Ő nem vett",params:[]),(code:20110,indent:0,string:"észre minket, mert takarásban álltunk.\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Megnyomott pár gombot, és a léghajó",params:[]),(code:20110,indent:0,string:"magától átalakult. Akkor lett",params:[]),(code:20110,indent:0,string:"olyan, amilyen most.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Fekete ruhás férfi?...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"(Az lenne, akit az emlékeimben",params:[]),(code:20110,indent:0,string:"láttam?)\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hogy nézett ki?\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Hát... Mint az a nindzsa fickó, Lance! Bár...",params:[]),(code:20110,indent:0,string:"Hmmm...\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Mégse... De... Valakire nagyon hasonlított...",params:[]),(code:20110,indent:0,string:"Akit már láttam valamikor... Sőt...\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"A mozgása olyan volt mint... Mint...\"",params:[]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Á, most nem ugrik be. Mindegy.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[7,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Nem baj, azért kösz az infót!\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Nincs mit!\"",params:[]),(code:10220,indent:0,string:"",params:[0,92,92,1,0,1,0]),(code:10220,indent:0,string:"",params:[0,15,15,1,0,1,0]),(code:10210,indent:0,string:"",params:[0,318,318,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"Chara2",graphic_index:4,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:318,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Kire emlékeztetett?...\"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"Chara2",graphic_index:4,direction:1,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat: