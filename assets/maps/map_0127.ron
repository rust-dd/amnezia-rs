tring:"Alen",params:[]),(code:20110,indent:0,string:"\"Helyes! Akkor...\"",params:[]),(code:11410,indent:0,string:"",params:[2]),(code:11550,indent:0,string:"Thunder2",params:[90,100,50]),(code:11050,indent:0,string:"",params:[3,3,2,1]),(code:11410,indent:0,string:"",params:[2]),(code:11510,indent:0,string:"Draco",params:[0,80,100,50]),(code:11330,indent:0,string:"",params:[7,8,0,0,12]),(code:11330,indent:0,string:"",params:[1,8,0,0,12]),(code:11330,indent:0,string:"",params:[2,8,0,0,12]),(code:11330,indent:0,string:"",params:[5,8,0,0,12]),(code:11330,indent:0,string:"",params:[6,8,0,0,12]),(code:11330,indent:0,string:"",params:[8,8,0,0,12]),(code:11330,indent:0,string:"",params:[10001,8,0,0,12]),(code:11330,indent:0,string:"",params:[10005,8,0,0,12]),(code:11410,indent:0,string:"",params:[2]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mi volt ez? Megmozdult a",params:[]),(code:20110,indent:0,string:"léghajó...\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,28,0,0,29]),(code:11330,indent:0,string:"",params:[10005,8,0,0,28,0,0]),(code:11410,indent:0,string:"",params:[5]),(code:11010,indent:0,string:"",params:[0]),(code:11410,indent:0,string:"",params:[15]),(code:10810,indent:0,string:"",params:[126,9,12]),(code:10210,indent:0,string:"",params:[0,312,312,0]),(code:11410,indent:0,string:"",params:[1]),(code:11020,indent:0,string:"",params:[0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:0,condition:(flags:1,switch_a:312,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:0,indent:0,string:"",params:[])])]),(id:10,x:11,y:1,name:"EV0010",pages:[(trigger:1,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:tr