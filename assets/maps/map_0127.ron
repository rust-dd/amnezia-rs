"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Hmmm... Szólok Stark-nak, hogy",params:[]),(code:20110,indent:1,string:"forduljunk vissza.\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22010,indent:0,string:"",params:[]),(code:10130,indent:1,string:"Chara1",params:[2,0,0]),(code:10110,indent:1,string:"?????",params:[]),(code:20110,indent:1,string:"\"Végre... Már azt hittem sose",params:[]),(code:20110,indent:1,string:"nyílik ki...\"",params:[]),(code:10110,indent:1,string:"?????",params:[]),(code:20110,indent:1,string:"\"Hé! Hát te meg ki vagy?\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Ezt akár én is kérdezhetném...",params:[]),(code:20110,indent:1,string:"Lévén ez a mi léghajónk...\"",params:[]),(code:10130,indent:1,string:"Chara1",params:[2,0,0]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Tray de Kalver vagyok, a tyran-i",params:[]),(code:20110,indent:1,string:"helyőrség parancsnoka.\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Ron K. Blade, zsoldos.\"",params:[]),(code:10130,indent:1,string:"Chara1",params:[2,0,0]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Örvendek.\"",params:[]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Jelentették a járőrök, hogy",params:[]),(code:20110,indent:1,string:"egy furcsa tárgy szállt le az",params:[]),(code:20110,indent:1,string:"erdőben.\"",params:[]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Azt jöttem ellenőrizni. Nem tudom,",params:[]),(code:20110,indent:1,string:"hogy mi ez a jármű, de amikor",params:[]),(code:20110,indent:1,string:"átkutattam, akkor üres volt...\"",params:[]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Én még nem láttam olyat, hogy"