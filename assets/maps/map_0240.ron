s az utasok felől egy pisszenést\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"se hallani... Mi folyik itt? Hová",params:[]),(code:20110,indent:0,string:"tűntek a matrózok, és mi van az",params:[]),(code:20110,indent:0,string:"utasokkal???\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Holnap elkezdem végigjárni a",params:[]),(code:20110,indent:0,string:"kabinokat...\'\"",params:[]),(code:10220,indent:0,string:"",params:[0,67,67,1,0,1,0]),(code:10210,indent:0,string:"",params:[0,510,510,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:143,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:4,switch_a:0,switch_b:0,variable_id:67,variable_value:4,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Egy újabb napló-lap...\"",params:[]),(code:11330,indent:0,string:"",params:[10005,8,0,0,34,5,84,111,114,99,104,1]),(code:11410,indent:0,string:"",params:[10]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'Ötödik nap: Uramisten... A... A",params:[]),(code:20110,indent:0,string:"kabinokban nincs senki, és minden",params:[]),(code:20110,indent:0,string:"csupa vér...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Már csak három matróz van",params:[]),(code:20110,indent:0,string:"életben, ők is bezárkóztak az",params:[]),(code:20110,indent:0,string:"egyik kabinba...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mintha... Valaki vagy valami",params:[]),(code:20110,indent:0,string:"pusztítaná az embereket a hajón...",params:[]),(code:20110,indent:0,string:"Mi van, ha...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(c