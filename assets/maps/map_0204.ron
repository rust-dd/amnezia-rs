:"Tovább >>",params:[1]),(code:10,indent:4,string:"",params:[]),(code:20141,indent:3,string:"",params:[]),(code:10,indent:3,string:"",params:[]),(code:22011,indent:2,string:"",params:[]),(code:12010,indent:2,string:"",params:[0,301,0,0,0,0]),(code:12010,indent:3,string:"",params:[5,9,0,0,0,1]),(code:10,indent:4,string:"",params:[]),(code:22010,indent:3,string:"",params:[]),(code:10140,indent:4,string:"Dianos/Tovább >>",params:[0]),(code:20140,indent:4,string:"Dianos",params:[0]),(code:10330,indent:5,string:"",params:[0,0,9]),(code:10220,indent:5,string:"",params:[0,47,47,1,0,1,0]),(code:12010,indent:5,string:"",params:[1,47,0,4,0,0]),(code:12120,indent:6,string:"",params:[20]),(code:10,indent:6,string:"",params:[]),(code:22011,indent:5,string:"",params:[]),(code:10,indent:5,string:"",params:[]),(code:20140,indent:4,string:"Tovább >>",params:[1]),(code:10,indent:5,string:"",params:[]),(code:20141,indent:4,string:"",params:[]),(code:10,indent:4,string:"",params:[]),(code:22011,indent:3,string:"",params:[]),(code:10,indent:3,string:"",params:[]),(code:22011,indent:2,string:"",params:[]),(code:12120,indent:2,string:"",params:[2]),(code:12110,indent:2,string:"",params:[20]),(code:10130,indent:2,string:"Ron",params:[3,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Gyerünk!\"",params:[]),(code:10660,indent:2,string:"FinalBoss2",params:[0,0,100,100,50]),(code:10660,indent:2,string:"FinalBoss2",params:[1,0,100,100,50]),(code:10710,indent:2,string:"Draco3",params:[0,51,1,0,0,0]),(code:10,indent:2,string:"",params:[]),(code:22010,indent:1,string:"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Azért, mert Tribal volt...\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Micsoda??? De hát, ők",params:[]),(code:20110,indent:2,string:"már régen meghaltak...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Nem, nem haltak meg, csak",params:[]),(code:20110,indent:2,string:"elaltatták a testüket.\"",params:[]),(code:12010,indent:2,string:"",params:[0,612,0,0,0,1]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"A Tribalok rájöttek az örök élet",params:[]),(code:20110,indent:3,string:"titkára, de ehhez más élőlények",params:[]),(code:20110,indent:3,string:"életenergiájára volt szükségük.\"",params:[]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"Megépítették az életelszívó",params:[]),(code:20110,indent:3,string:"gépeiket, és így megkezdték",params:[]),(code:20110,indent:3,string:"örök életüket, csak azzal nem",params:[]),(code:10110,indent:3,string:"számoltak, hogy a környező",params:[]),(code:20110,indent:3,string:"élővilágot teljesen kiszipolyozzák,",params:[]),(code:20110,indent:3,string:"teljesen elpusztítják ezáltal.\"",params:[]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"Mikor minden és mindenki",params:[]),(code:20110,indent:3,string:"elpusztult körülöttük, nem maradt",params:[]),(code:20110,indent:3,string:"más választásuk, mint elaltatni",params:[]),(code:10110,indent:3,string:"a testüket, így az életfolyamataik",params:[]),(code:20110,indent:3,string:"leálltak, és nem volt szükség külső",params:[]),(code:20110,indent:3,string:"energiára.\"",params:[]),(code:10,indent:3,string:"",params:[]),(code:22010,indent:2,string:"",params:[]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"A Tribalok a környezetük",params:[]),(code:20110,indent:3,string:"életenergiáját szívták el, és",params:[]),(code:20110,indent:3,string:"amikor minden élet kipusztult",params:[]),(code:10110,indent:3,string:"körülöttük, akkor nem maradt",params:[]),(code:20110,indent:3,string:"más választásuk, mint elaltatni",params:[]),(code:20110,indent:3,string:"magukat, hogy az élővilág újra",params:[]),(code:20110,indent:3,string:"kialakulhasson.\"",params:[]),(code:10,indent:3,string:"",params:[]),(code:22011,indent:2,string:"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Most már értem... Minden a",params:[]),(code:20110,indent:2,string:"helyére került...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"... Nekem nem...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Valahogy... Van egy olyan",params:[]),(code:20110,indent:2,string:"érzésem, hogy még korántsem",params:[]),(code:20110,indent:2,string:"tudunk mindent...\"",params:[]),(code:10130,indent:2,string:"Alen",params:[0,0,0]),(code:10110,indent:2,string:"Alen",params:[]),(code:20110,indent:2,string:"\"Hát... Akkor már nem is fogunk",params:[]),(code:20110,indent:2,string:"többet megtudni. Az egyetlen személy,",params:[]),(code:20110,indent:2,string:"aki tudott mindent, halott...\"",params:[]),(code:10130,indent:2,string:"Chara1",params:[2,0,0]),(code:10110,indent:2,string:"Tray",params:[]),(code:20110,indent:2,string:"\"Szerintem most nem ez a legnagyobb",params:[]),(code:20110,indent:2,string:"problémánk... Ha minden igaz, amit",params:[]),(code:20110,indent:2,string:"Ron mondott, akkor...\"",params:[]),(code:10110,indent:2,string:"Tray",params:[]),(code:20110,indent:2,string:"\"Mindenképpen meg kell",params:[]),(code:20110,indent:2,string:"akadályoznunk az ébredést!\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Igen, de... hogyan?\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Hmmm...\"",params:[]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Először ki kéne deríteni, hogy",params:[]),(code:20110,indent:2,string:"a folyamat beindult -e már...\"",params:[]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Hé, az mi lehet ott hátul?\"",params:[]),(code:11330,indent:2,string:"",params:[10001,8,0,0,12]),(code:11330,indent:2,string:"",params:[5,8,0,0,12]),(code:10120,indent:2,string:"",params:[0,2,1,1]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Nem tudom...\"",params:[]),(code:11550,indent:2,string:"Remote",params:[50,100,50]),(code:11330,indent:2,string:"",params:[10001,8,0,0,29,7,0]),(code:11410,indent:2,string:"",params:[6]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Valamilyen gép...\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Az ébresztést valószínűleg egy",params:[]),(code:20110,indent:2,string:"fejlettebb masina végzi. Azt kéne",params:[]),(code:20110,indent:2,string:"elpusztítanunk...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Lehetséges, hogy az lenne az?\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Na mindjárt...\"",params:[]),(code:11510,indent:2,string:"LastBattleIntro",params:[0,80,100,50]),(code:11550,indent:2,string:"ELECTRIX",params:[80,100,50]),(code:11330,indent:2,string:"",params:[10001,8,0,0,28,28,26,24,0,2,2,25,27,29,29]),(code:10210,indent:2,st