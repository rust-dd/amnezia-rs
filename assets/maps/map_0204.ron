[]),(code:20110,indent:1,string:"\"Nem... Csak elaltatták a testüket...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Ők csak kegyetlen paraziták,",params:[]),(code:20110,indent:1,string:"akik a környezetük energiáját",params:[]),(code:20110,indent:1,string:"szívják el...\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Akkor ezért voltak hosszúéletűek...",params:[]),(code:20110,indent:1,string:"Pótolták az elhasznált energiát...\"",params:[]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Másokéból...\"",params:[]),(code:12010,indent:1,string:"",params:[0,612,0,0,0,0]),(code:10130,indent:2,string:"Ron",params:[4,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Nem hosszúéletűek...",params:[]),(code:20110,indent:2,string:"Örökéletűek...\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:22011,indent:1,string:"",params:[]),(code:10130,indent:1,string:"Alen",params:[0,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10130,indent:1,string:"Chara1",params:[2,0,0]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Ha ez igaz, akkor...\"",params:[]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Mindenképpen meg kell",params:[]),(code:20110,indent:1,string:"akadályoznunk az ébredést!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[4,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Engem már... Nem érdekel...\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"\\N[1]! Azzal, hogy magadba",params:[]),(code:20110,indent:1