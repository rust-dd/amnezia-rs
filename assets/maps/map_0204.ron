10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"És... Ki volt az?\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Nem láttuk az arcát, de azt",params:[]),(code:20110,indent:1,string:"mondta, hogy ő egy Tribal...\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Micsoda??? De hát, ők",params:[]),(code:20110,indent:1,string:"már régen meghaltak...\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Nem, nem haltak meg, csak",params:[]),(code:20110,indent:1,string:"elaltatták a testüket.\"",params:[]),(code:12010,indent:1,string:"",params:[0,612,0,0,0,1]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"A Tribalok rájöttek az örök élet",params:[]),(code:20110,indent:2,string:"titkára, de ehhez más élőlények",params:[]),(code:20110,indent:2,string:"életenergiájára volt szükségük.\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Megépítették az életelszívó",params:[]),(code:20110,indent:2,string:"gépeiket, és így megkezdték",params:[]),(code:20110,indent:2,string:"örök életüket, csak azzal nem",params:[]),(code:10110,indent:2,string:"számoltak, hogy a környező",params:[]),(code:20110,indent:2,string:"élővilágot teljesen kiszipolyozzák,",params:[]),(code:20110,indent:2,string:"teljesen elpusztítják ezáltal.\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Mikor minden és mindenki",params:[]),(code:20110,indent:2,string:"elpusztult körülöttük, nem maradt",params:[]),(code:20110,indent:2,string:"más választásuk, mint elaltatni",params:[]),(code:10110,indent:2,string:"a testüket, így az életfolyamataik",params:[]),(code:20110,indent:2,string:"leálltak, és nem volt szükség külső",params:[]),(code:20110,indent:2,string:"energiára.\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:22010,indent:1,string:"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"A Tribalok a környezetük",params:[]),(code:20110,indent:2,string:"életenergiáját szívták el, és",params:[]),(code:20110,indent:2,string:"amikor minden élet kipusztult",params:[]),(code:10110,indent:2,string:"körülöttük, akkor nem maradt",params:[]),(code:20110,indent:2,string:"más választásuk, mint elaltatni",params:[]),(code:20110,indent:2,string:"magukat, hogy az élővilág újra",params:[]),(code:20110,indent:2,string:"kialakulhasson.\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:22011,indent:1,string:"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10130,indent:1,string:"Chara1",params:[2,0,0]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Ha ez igaz, akkor...\"",params:[]),(code:10110,indent:1,string:"Tray",params:[]),(code:20110,indent:1,string:"\"Mindenképpen meg kell",params:[]),(code:20110,indent:1,string:"akadályoznunk az ébredést!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Igen, de... hogyan?\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Hmmm...\"",params:[]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Először ki kéne deríteni, hogy",params:[]),(code:20110,indent:1,string:"a folyamat beindult -e már...\"",params:[]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Hé, az mi lehet ott hátul?\"",params:[]),(code:11330,indent:1,string:"",params:[10001,8,0,0,12]),(code:11330,indent:1,string:"",params:[5,8,0,0,12]),(code:10120,indent:1,string:"",params:[0,2,1,1]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Nem tudom...\"",params:[]),(code:11550,indent:1,string:"Remote",params:[50,100,50]),(code:11330,indent:1,string:"",params:[10001,8,0,0,29,7,0]),(code:11410,indent:1,string:"",params:[6]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Valamilyen gép...\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Az ébresztést valószínűleg egy",params:[]),(code:20110,indent:1,string:"fejlettebb masina végzi. Azt kéne",params:[]),(code:20110,indent:1,string:"elpusztítanunk...\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Lehetséges, hogy az lenne az?\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Na mindjárt...\"",params:[]),(code:11510,indent:1,string:"LastBattleIntro",params:[0,80,100,50]),(code:11550,indent:1,string:"ELECTRIX",params:[80,100,50]),(code:11330,indent:1,string:"",params:[10001,8,0,0,28,28,26,24,0,2,2,25,27,29,29]),(code:10210,indent:1,string:"",params:[0,469,469,1]),(code:11410,indent:1,string:"",params:[3]),(code:10130,indent:1,string:"Ron",params:[5,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"!!!\"",params:[]),(code:11410,indent:1,string:"",params:[5]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Géphang valahonnan",params:[]),(code:20110,indent:1,string:"\"Ébresztés beindítva.",params:[]),(code:20110,indent:1,string:"Fokozott védelmi rendszer élesítve.\"",params:[]),(code:10110,indent:1,string:"Géphang valahonnan",params:[]),(code:20110,indent:1,string:"\"FIGYELEM! Betolakodók azonosítva!",params:[]),(code:20110,indent:1,string:"Nem Tribal faj. Azonnal hagyják el az",params:[]),(code:20110,indent:1,string:"Ébresztő Termet!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[3,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Nem! Nem nézhetjük tétlenül,",params:[]),(code:20110,indent:1,string:"hogy a Tribalok visszatérjenek!\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Géphang valahonnan",params:[]),(code:20110,indent:1,string:"\"Lélekőr aktiválva. Elsődleges harci készültség!",params:[]),(code:20110,indent:1,string:"Második felszólítás: azonnal hagyják el az",params:[]),(code:20110,indent:1,string:"Ébresztő Termet!\"",params:[]),(code:10130,indent:1,string:"Alen",params:[0,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"... Eszünkben sincs!\"",params:[]),(code:11520,indent:1,string:"",params:[2000]),(code:10110,indent:1,string:"Géphang valahonnan",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10210,indent:1,string:"",params:[0,469,469,0]),(code:11410,indent:1,string:"",params:[5]),(code:11510,indent:1,string:"FinalBoss2",params:[0,100,100,50]),(code:10110,indent:1,string:"Géphang valahonnan",params:[]),(code:20110,indent:1,string:"\"Behatolók azonnali eliminálása!\"",params:[]),(code:10330,indent:1,string:"",params:[1,0,2]),(code:10130,indent:1,string:"Tiffany",params:[3,0,0]),(code:10110,indent:1,string:"Tiffany",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10110,indent:1,string:"Tiffany",params:[]),(code:20110,indent:1,string:"\"Ha harcolnunk kell...\"",params:[]),(code:10130,indent:1,string:"Alen",params:[0,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"... akkor harc