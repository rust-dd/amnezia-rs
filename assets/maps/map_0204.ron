ng:"\"Elég volt a színjátékból... Vedd",params:[]),(code:20110,indent:1,string:"le a maszkod!\"",params:[]),(code:11410,indent:1,string:"",params:[2]),(code:11510,indent:1,string:"Killer",params:[0,90,100,50]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"??????",params:[]),(code:20110,indent:1,string:"\"Hehh... Mi van, nem jöttetek rá, hogy ki vagyok?\"",params:[]),(code:11410,indent:1,string:"",params:[10]),(code:11330,indent:1,string:"",params:[10005,8,0,0,13]),(code:11410,indent:1,string:"",params:[1]),(code:11330,indent:1,string:"",params:[10005,8,0,0,14]),(code:11410,indent:1,string:"",params:[10]),(code:10110,indent:1,string:"??????",params:[]),(code:20110,indent:1,string:"\"Ezek szerint nem volt elég nyom, ami rám",params:[]),(code:20110,indent:1,string:"utalt volna...\"",params:[]),(code:10130,indent:1,string:"Tiffany",params:[4,0,0]),(code:10110,indent:1,string:"Tiffany",params:[]),(code:20110,indent:1,string:"\"Ki... Ki vagy?...\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"??????",params:[]),(code:20110,indent:1,string:"\"Ugyan, Tiffany kedves, miért áruljam el?",params:[]),(code:20110,indent:1,string:"Elég annyi, hogy Tribal vagyok!\"",params:[]),(code:12010,indent:1,string:"",params:[0,613,0,0,0,1]),(code:10130,indent:2,string:"Ron",params:[0,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Tribal... Hát persze...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Idáig aludtatok...\"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"??????",params:[]),(code:20110,indent:2,string:"\"És most érkezett el az idő az ébredésre!\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:22010,indent:1,string:"",params:[]),(code:10130,indent:2,string:"Ron",params:[0,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Mi??? Az nem lehet... Ők már",params:[]),(code:20110,indent:2,string:"több száz éve meghaltak...\"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"??????",params:[]),(code:20110,indent:2,string:"\"Tévedés... Több száz éve eltűntek, de nem haltak",params:[]),(code:20110,indent:2,string:"meg... Csupán elaltatták a testüket...\"",params:[]),(code:10110,indent:2,string:"??????",params:[]),(code:20110,indent:2,string:"\"És most elérkezett az idő az ébredésre...\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:22011,indent:1,string:"",params:[]),(code:12010,indent:1,string:"",params:[0,614,0,0,0,1]),(code:10130,indent:2,string:"Ron",params:[0,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Te pedig... Felébredtél, amikor",params:[]),(code:20110,indent:2,string:"ellopták a medált...\"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"??????",params:[]),(code:20110,indent:2,string:"\"Pontosan!\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:22010,indent:1,string:"",params:[]),(code:10130,indent:2,string:"Ron",params:[0,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"De... Te hogy maradtál ébren?\"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"??????",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"??????",params:[]),(code:20110,indent:2,string:"\"Az a szemét tolvaj... Betört a kastélyunkba,",params:[]),(code:20110,indent:2,string:"ellopta a medált, és megpróbálta",params:[]),(code:20110,indent:2,string:"megsemmisíteni...\"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"??????",params:[]),(code:20110,indent:2,string:"\"De azzal nem számolt, hogy biztonsági",params:[]),(code:20110,indent:2,string:"intézkedésként a lélekkeltő egyikőnket",params:[]),(code:20110,indent:2,string:"felébresztette a medál eltűnése