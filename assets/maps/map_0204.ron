ndent:1,string:"",params:[1,15,0,15,1,1]),(code:11330,indent:2,string:"",params:[10001,8,0,0,29,14,6]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Azért, mert...\"",params:[]),(code:11410,indent:2,string:"",params:[2]),(code:11510,indent:2,string:"FinalTruth",params:[3000,100,100,50]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Mert...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"... Nem!\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Valahogy nincs rendjén ez az",params:[]),(code:20110,indent:2,string:"egész... Mintha egy óriási",params:[]),(code:20110,indent:2,string:"színjátékot látnánk...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Mintha...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"... Hát persze... Összeáll a kép...\"",params:[]),(code:10130,indent:2,string:"Alen",params:[0,0,0]),(code:10110,indent:2,string:"Alen",params:[]),(code:20110,indent:2,string:"\"... Beavatnál minket is?\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Túl sok jel mutatott Darenre...",params:[]),(code:20110,indent:2,string:"Túlzottan nyílvánvaló volt, hogy",params:[]),(code:20110,indent:2,string:"ő követte el a dolgokat...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Most is céltudatosan egyesszámban",params:[]),(code:20110,indent:2,string:"beszélt, mintha ő lenne az irányító, ő",params:[]),(code:20110,indent:2,string:"lenne a titokzatos őrült...\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Ő is volt...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Nem. Szerintem nem ez a helyzet...\"",params:[]),(code:10130,indent:2,string:"Chara1",params:[2,0,0]),(code:10110,indent:2,string:"Tray",params:[]),(code:20110,indent:2,string:"\"...?\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Emlékeztek? Az erődben, amikor",params:[]),(code:20110,indent:2,string:"beestem a kazamatákba, végighallgattam",params:[]),(code:20110,indent:2,string:"néhány beszélgetést.\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Ugyan senki se tudta az ottaniak",params:[]),(code:20110,indent:2,string:"közül, hogy mi is zajlik körülöttük,",params:[]),(code:20110,indent:2,string:"de végig TÖBBESSZÁMBAN beszéltek!\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Ezen kívül ott van a titokzatos",params:[]),(code:20110,indent:2,string:"parancsnok, aki csak jelbeszéddel",params:[]),(code:20110,indent:2,string:"kommunikál.\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Mintha nem akarná, hogy megtudják,",params:[]),(code:20110,indent:2,string:"milyen a hangja. Vajon miért...?\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Azért, mert a parancsnokot",params:[]),(code:20110,indent:2,string:"két személy játszotta el! Hol az",params:[]),(code:20110,indent:2,string:"egyik, hol a másik!\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Ugyanaz a kettő, akik kiagyalták ezt",params:[]),(code:20110,indent:2,string:"a gigantikus tervet, akik megalkották",params:[]),(code:20110,indent:2,string:"az ál-császárságot, és...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"... akik elkövették a",params:[]),(code:20110,indent:2,string:"gyilkosságokat.\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Az elejétől fogva két személy",params:[]),(code:20110,indent:2,string:"irányította ezt a hatalmas",params:[]),(code:20110,indent:2,string:"sakkjátszmát!\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Daren volt az Eszköz. Ő mindig",params:[]),(code:20110,indent:2,string:"az előtérben volt, ezért mutatott rá",params:[]),(code:20110,indent:2,string:"az összes nyom. A másik személy",params:[]),(code:10110,indent:2,string:"az Agy, aki mindvégig a háttérben",params:[]),(code:20110,indent:2,string:"maradt, hogy a gyanú legkisebb",params:[]),(code:20110,indent:2,string:"szikrája se vetülhessen rá...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"... és aki most is itt van velünk.\"",params:[]),(code:10130,indent:2,string:"Alen",params:[0,0,0]),(code:10110,indent:2,string:"Alen",params:[]),(code:20110,indent:2,string:"\"Mi...? Közülünk valaki...?\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Kicsoda...?\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Az a valaki, aki ennek az egésznek",params:[]),(code:20110,indent:2,string:"az értelmi szerzője volt. Egy Tribal.\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Micsoda??? De hát, ők",params:[]),(code:20110,indent:2,string:"már régen meghaltak...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Nem, nem haltak meg, csak",params:[]),(code:20110,indent:2,string:"elaltatták a testüket.\"",params:[]),(code:12010,indent:2,string:"",params:[0,612,0,0,0,1]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"A Tribalok rájöttek az örök élet",params:[]),(code:20110,indent:3,string:"titkára, de ehhez más élőlények",params:[]),(code:20110,indent:3,string:"életenergiájára volt szükségük.\"",params:[]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"Megépítették az életelszívó",params:[]),(code:20110,indent:3,string:"gépeiket, és így megkezdték",params:[]),(code:20110,indent:3,string:"örök életüket, csak azzal nem",params:[]),(code:10110,indent:3,string:"számoltak, hogy a környező",params:[]),(code:20110,indent:3,string:"élővilágot teljesen kiszipolyozzák,",params:[]),(code:20110,indent:3,string:"teljesen elpusztítják ezáltal.\"",params:[]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"Mikor minden és mindenki",params:[]),(code:20110,indent:3,string:"elpusztult körülöttük, nem maradt",params:[]),(code:20110,indent:3,string:"más választásuk, mint elaltatni",params:[]),(code:10110,indent:3,string:"a testüket, így az életfolyamataik",params:[]),(code:20110,indent:3,string:"leálltak, és nem volt szükség külső",params:[]),(code:20110,indent:3,string:"energiára.\"",params:[]),(code:10,indent:3,string:"",params:[]),(code:22010,indent:2,string:"",params:[]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"A Tribalok a környezetük",params:[]),(code:20110,indent:3,string:"életenergiáját szívták el, és",params:[]),(code:20110,indent:3,string:"amikor minden élet kipusztult",params:[]),(code:10110,indent:3,string:"körülöttük, akkor nem maradt",params:[]),(code:20110,indent:3,string:"más választásuk, mint elaltatni",params:[]),(code:20110,indent:3,string:"magukat, hogy az élővilág újra",params:[]),(code:20110,indent:3,string:"kialakulhasson.\"",params:[]),(code:10,indent:3,string:"",params:[]),(code:22011,indent:2,string:"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Egészen idáig aludtak, és csak",params:[]),(code:20110,indent:2,string:"arra vártak, hogy az élővilág újból",params:[]),(code:20110,indent:2,string:"kialakuljon, és ők felébredhessenek.\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Tif medáljának a segítségével...\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"??? Nem az ajtónyitáshoz kellett a",params:[]),(code:20110,indent:2,string:"medál...?\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Nem, az ajtón szerintem csak egy",params:[]),(code:20110,indent:2,string:"sima időzár van, amit a megfelelő",params:[]),(code:20110,indent:2,string:"személy bármikor kinyithat...\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"Ahha. Akkor itt sántított az én",params:[]),(code:20110,indent:2,string:"elméletem...\"",params:[]),(code:10130,indent:2,string:"Alen",params:[0,0,0]),(code:10110,indent:2,string:"Alen",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"Alen",params:[]),(code:20110,indent:2,string:"\"Őrület...\"",params:[]),(code:11330,indent:2,string:"",params:[5,8,0,0,15]),(code:10130,indent:2,string:"Tiffany",params:[3,0,0]),(code:10110,indent:2,string:"Tiffany",params:[]),(code:20110,indent:2,string:"\"De... Daren azt mondta, hogy",params:[]),(code:20110,indent:2,string:"ő a Tribal. Két Tribal van...?\"",params:[]),(code:11330,indent:2,string:"",params:[5,8,0,0,14]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Nem. Daren nem volt Tribal.",params:[]),(code:20110,indent:2,string:"Ő egy egyszerű ember volt, aki",params:[]),(code:20110,indent:2,string:"találkozott a Triballal, és...\"",params:[]),(code:11410,indent:2,string:"",params:[3]),(code:11510,indent:2,string:"(OFF)",params:[0,0,100,50]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"... beleszeretett.\"",params:[]),(code:11410,indent:2,string:"",params:[5]),(code:11330,indent:2,string:"",params:[10001,8,0,0,15]),(code:11410,indent:2,string:"",params:[1]),(code:11330,indent:2,string:"",params:[10001,8,0,0,12]),(code:11410,indent:2,string:"",params:[5]),(code:11510,indent:2,string:"Killer",params:[0,90,100,50]),(code:10120,indent:2,string:"",params:[0,2,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Igaz, Stella?\"",params:[]),(code:11330,indent:2,string:"",params:[5,8,0,0,12,28,28,26,24,0,2,25,27,29,29]),(code:11330,indent:2,string:"",params:[6,8,0,0,28,26,24,0,2,25,27,29]),(code:11330,indent:2,string:"",params:[7,8,0,0,28,26,24,0,2,25,27,29]),(code:11330,indent:2,string:"",params:[8,8,0,0,28,26,24,0,2,25,27,29]),(code:11330,indent:2,string:"",params:[9,8,0,0,28,26,24,0,2,25,27,29]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"Mindenki",params:[]),(code:20110,indent:2,string:"\"???!!!\"",params:[]),(code:11410,indent:2,string:"",params:[10]),(code:11330,indent:2,string:"",params:[23,8,0,0,1,14]),(code:11410,indent:2,string:"",params:[20]),(code:11330,indent:2,string:"",params:[23,8,0,0,2,2,5,1,1,1,14]),(code:11410,indent:2,string:"",params:[30]),(code:11330,indent:2,string:"",params:[23,8,0,0,13]),(code:11410,indent:2,string:"",params:[20]),(code:11330,indent:2,string:"",params:[23,8,0,0,14]),(code:11410,indent:2,string:"",params:[10]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Téged védett végig, ezért vallotta",params:[]),(code:20110,indent:2,string:"saját magát Tribalnak, ezért hagyott",params:[]),(code:20110,indent:2,string:"maga után nyílvánvaló nyomokat,",params:[]),(code:10110,indent:2,string:"hogy minden gyanú rá terelődjön,",params:[]),(code:20110,indent:2,string:"és Rád senki se gondoljon...\"",params:[]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"... Gratulálok.\"",params:[]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Nem hittem volna, hogy akár",params:[]),(code:20110,indent:2,string:"csak a töredékére is rájössz annak,",params:[]),(code:20110,indent:2,string:"hogy mi folyik itt valójában...\"",params:[]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Úgy látszik alábecsültelek.\"",params:[]),(code:10130,indent:2,string:"Alen",params:[0,0,0]),(code:10110,indent:2,string:"Alen",params:[]),(code:20110,indent:2,string:"\"De Te... Meghaltál...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Ez is része volt a színjátéknak...",params:[]),(code:20110,indent:2,string:"A halál.\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Tökéletesen elterveztétek az egészet,",params:[]),(code:20110,indent:2,string:"Daren még össze is kaszabolt kicsit,",params:[]),(code:20110,indent:2,string:"hogy véres legyél, és tényleg teljesen",params:[]),(code:10110,indent:2,string:"hiteles legyen a jelenet. El is hittük",params:[]),(code:20110,indent:2,string:"mindannyian, hogy tényleg halott",params:[]),(code:20110,indent:2,string:"vagy...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Egy dologgal azonban nem",params:[]),(code:20110,indent:2,string:"számoltál...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Amikor megittad a Choriadnát,",params:[]),(code:20110,indent:2,string:"akkor a szer azonnal hatni kezdett,",params:[]),(code:20110,indent:2,string:"Te elejtetted az üvegcsét, és az",params:[]),(code:10110,indent:2,string:"összetört a földön. Sokáig nem",params:[]),(code:20110,indent:2,string:"is értettem, hogy mik azok az",params:[]),(code:20110,indent:2,string:"üvegszilánkok a \"holttested\"",params:[]),(code:20110,indent:2,string:"mellett...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"De most már tiszta a kép.\"",params:[]),(code:10130,indent:2,string:"Stark",params:[1,0,0]),(code:10110,indent:2,string:"Stark",params:[]),(code:20110,indent:2,string:"\"... Choriadna...?\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Igen. Ez egy olyan szer, ami",params:[]),(code:20110,indent:2,string:"minimálisra csökkenti a test",params:[]),(code:20110,indent:2,string:"életfunkcióit, és így a test teljesen",params:[]),(code:10110,indent:2,string:"tetszhalotti állapotba kerül.",params:[]),(code:20110,indent:2,string:"Ennek a segítségével akadályozzák",params:[]),(code:20110,indent:2,string:"meg, hogy egy halálos betegség",params:[]),(code:20110,indent:2,string:"tovább roncsolja a szervezetet.\"",params:[]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Így van... Úgy látom tényleg",params:[]),(code:20110,indent:2,string:"mindenre rájöttél...\"",params:[]),(code:10130,indent:2,string:"Tiffany",params:[4,0,0]),(code:10110,indent:2,string:"Tiffany",params:[]),(code:20110,indent:2,string:"\"És Daren...? Őt miért kellett",params:[]),(code:20110,indent:2,string:"felhasználnod...? Miattad kellett...",params:[]),(code:20110,indent:2,string:"Megölnünk...\"",params:[]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Daren gyenge személyiség volt,",params:[]),(code:20110,indent:2,string:"könnyen tudtam manipulálni.\"",params:[]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Tökéletes eszköz volt a",params:[]),(code:20110,indent:2,string:"gyilkosságokhoz.\"",params:[]),(code:10130,indent:2,string:"Tiffany",params:[4,0,0]),(code:10110,indent:2,string:"Tiffany",params:[]),(code:20110,indent:2,string:"\"De... Szeretett téged...\"",params:[]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Igen. A szerelem vak. Daren",params:[]),(code:20110,indent:2,string:"volt a statisztikailag is",params:[]),(code:20110,indent:2,string:"nélkülözhető, szükséges áldozat.\"",params:[]),(code:10130,indent:2,string:"Ron",params:[3,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Nélkülözhető, szükséges áldozat...?!",params:[]),(code:20110,indent:2,string:"Te... Érzéketlen... Gyilkos...\"",params:[]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Csak nyugalom, még felmegy a",params:[]),(code:20110,indent:2,string:"vérnyomásod... Csak azt öltem meg",params:[]),(code:20110,indent:2,string:"eddig, akit meg kellett.\"",params:[]),(code:11510,indent:2,string:"(OFF)",params:[0,0,100,50]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:11330,indent:2,string:"",params:[23,8,0,0,28,0,29]),(code:11410,indent:2,string:"",params:[3]),(code:11550,indent:2,string:"Remote",params:[90,100,50]),(code:11410,indent:2,string:"",params:[15]),(code:11330,indent:2,string:"",params:[23,8,0,0,13]),(code:11410,indent:2,string:"",params:[1]),(code:11330,indent:2,string:"",params:[23,8,0,0,14]),(code:11410,indent:2,string:"",params:[1]),(code:11510,indent:2,string:"LastBattleIntro",params:[0,80,100,50]),(code:10210,indent:2,string:"",params:[0,469,469,1]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"És ezentúl is csak azt fogom megölni,",params:[]),(code:20110,indent:2,string:"akit muszáj...\"",params:[]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Ti például mindannyian az",params:[]),(code:20110,indent:2,string:"utamban vagytok!\"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"Géphang valahonnan",params:[]),(code:20110,indent:2,string:"\"Ébresztés beindítva.",params:[]),(code:20110,indent:2,string:"Fokozott védelmi rendszer élesítve.\"",params:[]),(code:10110,indent:2,string:"Géphang valahonnan",params:[]),(code:20110,indent:2,string:"\"FIGYELEM, betolakodók azonosítva!",params:[]),(code:20110,indent:2,string:"Elsődleges feladat: Tribal védelmezése.",params:[]),(code:20110,indent:2,string:"Másodlagos feladat: behatolók elpusztítása.\"",params:[]),(code:10110,indent:2,string:"Géphang valahonnan",params:[]),(code:20110,indent:2,string:"\"Lélekőr aktiválva, egyesítési folyamat indul.\"",params:[]),(code:11410,indent:2,string:"",params:[10]),(code:10210,indent:2,string:"",params:[0,615,615,0]),(code:11410,indent:2,string:"",params:[10]),(code:11060,indent:2,string:"",params:[2,0,3,2,0]),(code:11330,indent:2,string:"",params:[23,8,0,0,36,0,0,0,0,37]),(code:11410,indent:2,string:"",params:[45]),(code:10210,indent:2,string:"",params:[0,469,469,0]),(code:11410,indent:2,string:"",params:[10]),(code:11510,indent:2,string:"FinalBoss2",params:[0,100,100,50]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Ideje, hogy pontot tegyünk az",params:[]),(code:20110,indent:2,string:"ügy végére. Eljött az ébredés ideje!\"",params:[]),(code:11060,indent:2,string:"",params:[2,2,3,4,1]),(code:10130,indent:2,string:"Tiffany",params:[3,0,0]),(code:10110,indent:2,string:"Tiffany",params:[]),(code:20110,indent:2,string:"\"Lehet hogy eljött az ideje...\"",params:[]),(code:10130,indent:2,string:"Alen",params:[0,0,0]),(code:10110,indent:2,string:"Alen",params:[]),(code:20110,indent:2,string:"\"De nem fog bekövetkezni!\"",params:[]),(code:10130,indent:2,string:"Chara1",params:[2,0,0]),(code:10110,indent:2,string:"Tray",params:[]),(code:20110,indent:2,string:"\"Nem hagyjuk, hogy ismét",params:[]),(code:20110,indent:2,string:"kiszipolyozzátok a világot!\"",params:[]),(code:10130,indent:2,string:"Chara2",params:[2,0,0]),(code:10110,indent:2,string:"Lance",params:[]),(code:20110,indent:2,string:"\"De legalábbis megpróbálunk",params:[]),(code:20110,indent:2,string:"megállítani...\"",params:[]),(code:11060,indent:2,string:"",params:[2,0,3,4,1]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"Az emberi naivitás... Semmi esélyetek",params:[]),(code:20110,indent:2,string:"a Lélekőr ellen!\"",params:[]),(code:11060,indent:2,string:"",params:[2,2,3,4,1]),(code:10130,indent:2,string:"Ron",params:[2,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Egyszer már alábecsültél... Megy",params:[]),(code:20110,indent:2,string:"ez Neked többször is...\"",params:[]),(code:11060,indent:2,string:"",params:[2,0,3,4,1]),(code:10130,indent:2,string:"Stella",params:[1,0,0]),(code:10110,indent:2,string:"Stella",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:11060,indent:2,string:"",params:[2,2,3,4,1]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"Ki legyen \\N[1] mellett a csapatban?",params:[]),(code:10330,indent:2,string:"",params:[1,0,2]),(code:10330,indent:2,string:"",params:[1,0,3]),(code:10330,indent:2,string:"",params:[1,0,4]),(code:10330,indent:2,string: