ent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"De ha nem, akkor cápaeledel lesz",params:[]),(code:20110,indent:0,string:"belőled...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Rendben...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Nem mintha sok választási lehetőségem",params:[]),(code:20110,indent:0,string:"lenne...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[1,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Oké! Lássuk, mit tudsz!\"",params:[]),(code:11010,indent:0,string:"",params:[0]),(code:10810,indent:0,string:"",params:[71,28,18]),(code:11410,indent:0,string:"",params:[10]),(code:10210,indent:0,string:"",params:[0,180,180,0]),(code:11020,indent:0,string:"",params:[0]),(code:10210,indent:0,string:"",params:[0,179,179,1]),(code:0,indent:0,string:"",params:[])])]),(id:11,x:11,y:7,name:"EV0011",pages:[(trigger:0,graphic_name:"Chara2",graphic_index:4,direction:3,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:179,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:0,indent:0,string:"",params:[])])]),(id:12,x:11,y:9,name:"EV0012",pages:[(trigger:0,graphic_name:"Chara2",graphic_index:4,direction:3,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:179,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:0,indent:0,string:"",params:[])])]),(id:13,x:10,y:8,name:"EV0013",pages:[(trigger:3,graphic_name:"Chara4",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:181,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"... szóval a lányt üldözik. Értem. De",params:[]),(code:20110,indent:0,string:"te miért avatkozol bele?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mert... Olyan érzésem van, mintha",params:[]),(code:20110,indent:0,string:"ismerném Tiffany-t valahonnan... Csak",params:[]),(code:20110,indent:0,string:"nem tudom, hogy honnan...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[1,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Ehe. Szóval Tiffany-nak hívják. Szép",params:[]),(code:20110,indent:0,string:"neve van...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[7,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Rendben.\"",params:[]),(code:11330,indent:0,string:"",params:[10005,8,0,0,13]),(code:11330,indent:0,string:"",params:[14,8,0,0,15]),(code:11410,indent:0,string:"",params:[1]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Stan! Irány észak-északkelet, utol",params:[]),(code:20110,indent:0,string:"kell érnünk a Stalliont!\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Igenis, kapitány!\"",params:[]),(code:11330,indent:0,string:"",params:[10005,8,0,0,14]),(code:11330,indent:0,string:"",params:[14,8,0,0,2,2,3,2,2,34,5,84,111,114,99,104,1]),(code:11410,indent:0,string:"",params:[10]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"No! 1-2 napon belül utolérjük a hajót",params:[]),(code:20110,indent:0,string:"és akkor átszállhatsz rá. Addig is",params:[]),(code:20110,indent:0,string:"alhatsz lennt a legénységi szálláson.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Köszönöm.\"",params:[]),(code:10130,indent:0,string:"Alen",params:[1,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Ne köszönd! Ugye nem gondoltad,",params:[]),(code:20110,indent:0,string:"hogy ingyen szállítunk el a másik",params:[]),(code:20110,indent:0,string:"hajóig?\"",params:[]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Majd felszámítjuk az útiköltséget...\"",params:[]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Addig is nézz körül a hajón!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[7,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Oké.\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,2]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Várj!\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,0]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Igen?\"",params:[]),(code:10130,indent:0,string:"Alen",params:[1,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Mi a neved?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Ron K. Blade.\"",params:[]),(code:10130,indent:0,string:"Alen",params:[1,0,0]),(code:10110,indent:0,string:"Kapitány",params:[]),(code:20110,indent:0,string:"\"Alen Krane.\"",params:[]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Örvendek a szerencsének.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[7,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Részemről a szerencse.\"",params:[]),(code:10130,indent:0,string:"Alen",params:[1,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:11330,indent:0,string:"",params:[10005,8,0,0,0,1,1,12]),(code:11410,indent:0,string:"",params:[10]),(code:10210,indent:0,string:"",params:[0,181,181,1]),(code:0,indent:0,string:"",params:[])])]),(id:14,x:11,y:8,name:"Stan",pages:[(trigger:0,graphic_name:"Chara2",graphic_index:4,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:181,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:0,indent:0,string:"",params:[])])])])