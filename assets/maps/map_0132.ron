,string:"körülnézni? Ha tényleg nincs itt",params:[]),(code:20110,indent:0,string:"senki, akkor könnyű dolgunk lesz...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Igen, de még meg kell találnunk,",params:[]),(code:20110,indent:0,string:"hogy mivel szabadíthatjuk ki a",params:[]),(code:20110,indent:0,string:"léghajót...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Miért, te nem tudod?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nem...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mi lenne, ha párosával mennénk?",params:[]),(code:20110,indent:0,string:"Nagy csoportban csak zajt ütnénk,",params:[]),(code:20110,indent:0,string:"egyedül meg védtelenebbek vagyunk...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[1,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Eh, Tiffel akarsz menni, mi?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[5,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Ööö, hát... Megígértem, neki...",params:[]),(code:20110,indent:0,string:"És...\"",params:[]),(code:10130,indent:0,string:"Stella",params:[0,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Oké, menjünk párban. Én Darennel",params:[]),(code:20110,indent:0,string:"tartok.\"",params:[]),(code:10130,indent:0,string:"Daren",params:[1,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Heh...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Jó. Én egyedül megyek, mert engem",params:[]),(code:20110,indent:0,string:"ismernek. Ha mással lennék, az gyanús",params:[]),(code:20110,indent:0,string:"lenne.\"",params:[]),(code:10130,indent:0,string:"Chara2",params:[2,0,0]),(code:10110,indent:0,string:"Lance",params:[]),(code:20110,indent:0,string:"\"Én is egyedül megyek...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Hmmm... Tray, velem tartasz?\"",params:[]),(code:10130,indent:0,string:"Chara1",params:[2,0,0]),(code:10110,indent:0,string:"Tray",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Tray",params:[]),(code:20110,indent:0,string:"\"Miért ne?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Rendben.  Találkozzunk a",params:[]),(code:20110,indent:0,string:"trónteremnél, hogy megbeszélhessük",params:[]),(code:20110,indent:0,string:"a továbbiakat!\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[0,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Az merre van?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"A második emeleten.\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[0,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Oké.\"",params:[]),(code:11330,indent:0,string:"",params:[35,8,0,0,36,29,14,23,23,23,23,23,3,3,2,3,3,3,34,5,84,111,114,99,104,1,37]),(code:11330,indent:0,string:"",params:[32,8,0,0,36,3,3,3,0,0,34,5,84,111,114,99,104,1,37]),(code:11330,indent:0,string:"",params:[33,8,0,0,36,0,34,5,84,111,114,99,104,1