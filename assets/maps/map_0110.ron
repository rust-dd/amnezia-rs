ve_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:1,switch_a:291,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10320,indent:0,string:"",params:[1,0,136,0,1]),(code:10120,indent:0,string:"",params:[0,0,0,1]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hát... Köszönök mindent...\"",params:[]),(code:12010,indent:0,string:"",params:[0,294,0,0,0,1]),(code:10130,indent:1,string:"Alen",params:[1,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"Á, hagyd...\"",params:[]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"Tényleg, mi bajuk volt a rablóknak",params:[]),(code:20110,indent:1,string:"veled?\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Hát... Ez még azelőtt történt,",params:[]),(code:20110,indent:1,string:"mielőtt bármelyikőtökkel találkoztam",params:[]),(code:20110,indent:1,string:"volna...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Pénzszűkében álltam, és elvállaltam",params:[]),(code:20110,indent:1,string:"egy rablóírtó munkát. Ez a banda volt",params:[]),(code:20110,indent:1,string:"az.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Én akkor azt hittem, hogy",params:[]),(code:20110,indent:1,string:"miután kinyírtam a vezért, így",params:[]),(code:20110,indent:1,string:"sikerrel jártam, de ezek szerint nem.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"A banda másik fele ide jött át,",params:[]),(code:20110,indent:1,string:"és amikor lezuhantam, akkor",params:[]),(code:20110,indent:1,string:"egyből megismertek, és elfogtak.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Ha nem jöttök, akkor biztosan",params:[]),(code:20110,indent:1,string:"felkoncolnak...\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Uhh...\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22010,indent:0,string:"",params:[]),(code:11330,indent:1,string:"",params:[10001,8,0,0,13]),(code:11330,indent:1,string:"",params:[11,8,0,0,15]),(code:11410,indent:1,string:"",params:[1]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Főleg neked, Tif... Ha nem lopózol",params:[]),(code:20110,indent:1,string:"be a polgármester házába, és nem",params:[]),(code:20110,indent:1,string:"találod meg azt a papírt...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"... akkor már halott lennék...\"",params:[]),(code:10130,indent:1,string:"Tiffany",params:[0,0,0]),(code:10110,indent:1,string:"Tiffany",params:[]),(code:20110,indent:1,string:"\"Tudtam, hogy Te nem lehetsz",params:[]),(code:20110,indent:1,string:"gyilkos... Ezért törtem be a",params:[]),(code:20110,indent:1,string:"polgármester szobájába...\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Köszönöm...\"",params:[]),(code:11330,indent:1,string:"",params:[10001,8,0,0,14]),(code:11410,indent:1,string:"",params:[1]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Elmondom mi történt.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Még mielőtt bármelyikőtökkel",params:[]),(code:20110,indent:1,string:"találkoztam volna, Toranban el kellett",params:[]),(code:20110,indent:1,string:"kapnom egy tolvajt.\"",params:[]),(code:12010,indent:1,string:"",params:[0,54,0,0,0,1]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Ez sikerült is, de a tolvaj nekem",params:[]),(code:20110,indent:2,string:"rontott, és sajnos meg kellett",params:[]),(code:20110,indent:2,string:"ölnöm, hogy megvédjem magam.\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Amikor meghalt, elejtett egy",params:[]),(code:20110,indent:2,string:"megbízólevelet, amiben arra",params:[]),(code:20110,indent:2,string:"bízták meg, hogy lopja el",params:[]),(code:10110,indent:2,string:"a torani raktárból a teljes",params:[]),(code:20110,indent:2,string:"gabonakészletet.\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:22010,indent:1,string:"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Ugyan a tolvajt nem kaptam el, de",params:[]),(code:20110,indent:2,string:"elejtett egy megbízólevelet, amiben",params:[]),(code:20110,indent:2,string:"arra bízták meg, hogy lopja el",params:[]),(code:10110,indent:2,string:"a torani raktárból a teljes",params:[]),(code:20110,indent:2,string:"gabonakészletet.\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:22011,indent:1,string:"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"A levelet innen, Tyranból",params:[]),(code:20110,indent:1,string:"küldték neki, és nem más, mint",params:[]),(code:20110,indent:1,string:"maga a polgármester.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"A zuhanás után idejöttem, és",params:[]),(code:20110,indent:1,string:"gondoltam kicsit utánajárok ennek",params:[]),(code:20110,indent:1,string:"a dolognak.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Bejelentkeztem a polgármesterhez,",params:[]),(code:20110,indent:1,string:"és leültem a várakozópadra az",params:[]),(code:20110,indent:1,string:"irodája előtt.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Miután egy órát vártam, és nem",params:[]),(code:20110,indent:1,string:"jött ki senki, már azon voltam, hogy",params:[]),(code:20110,indent:1,string:"hagyom a fenébe az egészet, de",params:[]),(code:10110,indent:1,string:"hirtelen egy kiáltást hallottam",params:[]),(code:20110,indent:1,string:"bentről.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Berontottam az ajtón, de már",params:[]),(code:20110,indent:1,string:"csak a polgármestert találtam a",params:[]),(code:20110,indent:1,string:"padlón vérbe fagyva.\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Természetesen az őrök egy",params:[]),(code:20110,indent:1,string:"perc múlva ott teremtek, és",params:[]),(code:20110,indent:1,string:"azonnal engem gyanúsítottak...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Így kerültem börtönbe, és",params:[]),(code:20110,indent:1,string:"a guillotine közelébe. A többit",params:[]),(code:20110,indent:1,string:"már tudjátok...\"",params:[]),(code:10130,indent:1,string:"Alen",params:[0,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"Hmmm... Hát nem egészen...\"",params:[]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"Milyen kapcsolat volt Cezar és",params:[]),(code:20110,indent:1,string:"a polgármester között? Miért ölte",params:[]),(code:20110,indent:1,string:"meg a fickót az Esküdtbíró?\"",params:[]),(code:11330,indent:1,string:"",params:[11,8,0,0,14]),(code:10130,indent:1,string:"Tiffany",params:[3,0,0]),(code:10110,indent:1,string:"Tiffany",params:[]),(code:20110,indent:1,string:"\"Mert egy bűnszövetkezetet",params:[]),(code:20110,indent:1,string:"irányítottak. Ennek az adatait",params:[]),(code:20110,indent:1,string:"találtam meg a polgármesternél.\"",params:[]),(code:10110,indent:1,string:"Tiffany",params:[]),(code:20110,indent:1,string:"\"A profiljuk az volt, hogy",params:[]),(code:20110,indent:1,string:"Toranban kiraboltatták a raktárat,",