50,2,12,0,0,0,3,3,3,3,3,3,12]),(code:11410,indent:0,string:"",params:[20]),(code:11330,indent:0,string:"",params:[10005,8,0,0,15]),(code:11410,indent:0,string:"",params:[4]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Na? Mi a helyzet?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Semmi...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Tiffany?\"",params:[]),(code:12010,indent:0,string:"",params:[1,1,0,8,1,1]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"\\N[1]t keresi... Egyfolytában...\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22010,indent:0,string:"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"A többieket keresi...\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Nekünk is keresnünk kéne...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Sajnos semmi értelme... Nem",params:[]),(code:20110,indent:0,string:"ismerjük ki magunkat a szigeten, és",params:[]),(code:20110,indent:0,string:"csak mi is eltévednénk...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Ez igaz...\"",params:[]),(code:12010,indent:0,string:"",params:[0,35,0,0,0,1]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"De... Azért én körülnézek",params:[]),(code:20110,indent:1,string:"mégegyszer. Hátha...\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Jó. Megyek én is. A városban már",params:[]),(code:20110,indent:1,string:"körülkérdezősködtem, itt biztos",params:[]),(code:20110,indent:1,string:"nincs.\"",params:[]),(code:10130,indent:1,string:"Alen",params:[0,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"Talán valamelyik barlangban húzta",params:[]),(code:20110,indent:1,string:"meg magát a környéken...\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Hmmm... Elképzelhető.\"",params:[]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Szóljunk Tifnek is...\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22010,indent:0,string:"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Hallottad, hogy valami kivégzés lesz",params:[]),(code:20110,indent:1,string:"holnap? Úgy tudom mindenki odamegy,",params:[]),(code:20110,indent:1,string:"errefelé ez a fő látványosság.\"",params:[]),(code:10130,indent:1,string:"Alen",params:[0,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"Micsoda perverz szokás! De legalább",params:[]),(code:20110,indent:1,string:"körbekérdezősködünk.\"",params:[]),(code:10130,indent:1,string:"Stark",params:[1,0,0]),(code:10110,indent:1,string:"Stark",params:[]),(code:20110,indent:1,string:"\"Ja. Én is erre gondoltam.\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:11520,indent:0,string:"",params:[2000]),(code:11030,indent:0,string:"",params:[0,0,0,100,20,1]),(code:11410,indent:0,string:"",params:[20]),(code:10810,indent:0,string:"",params:[109,0,5]),(code:11030,in