:1),commands:[(code:11520,indent:0,string:"",params:[2000]),(code:11010,indent:0,string:"",params:[0]),(code:10630,indent:0,string:"Poses2",params:[1,4,0]),(code:11410,indent:0,string:"",params:[1]),(code:10810,indent:0,string:"",params:[13,38,57]),(code:11510,indent:0,string:"(OFF)",params:[0,100,100,50]),(code:11020,indent:0,string:"",params:[0]),(code:11510,indent:0,string:"Overwrld",params:[0,90,100,50]),(code:0,indent:0,string:"",params:[])])]),(id:12,x:3,y:8,name:"EV0012",pages:[(trigger:0,graphic_name:"Chara1",graphic_index:6,direction:1,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Ha játék közben ESC-et nyomsz, akkor bejön",params:[]),(code:20110,indent:0,string:"a főmenü. A főmenüben 5 opció van: Tárgy,",params:[]),(code:20110,indent:0,string:"Speciális, Felszerelés, Állásmentés és Kilépés.",params:[]),(code:10110,indent:0,string:"A Tárgy menüpontban tudod megvizsgálni, vagy",params:[]),(code:20110,indent:0,string:"használni az eddig összegyűjtött különböző",params:[]),(code:20110,indent:0,string:"tárgyaidat. Minden tárgy idekerül, gyógyitaltól",params:[]),(code:20110,indent:0,string:"kezdve a fegyverekig.",params:[]),(code:10110,indent:0,string:"A Speciális menüpontban a kiválasztott karakter",params:[]),(code:20110,indent:0,string:"speciális támadásait, mozgásait tudod",params:[]),(code:20110,indent:0,string:"jobban megvizsgálni. Használni persze csak",params:[]),(code:20110,indent:0,string:"harcban használhatod őket!",params:[]),(code:10110,indent:0,string:"A Felszerelés menüpontban tudod változtatni",params:[]),(code:20110,indent:0,string:"a karakterek ruházatát, fegyvereit. Az adott",params:[]),(code:20110,indent:0,string:"típusú felszerelési névre rámenve alul bejönnek",params:[]),(code:20110,indent:0,string:"a rendelkezésre álló cserélhető tárgyak,",params:[]),(code:10110,indent:0,string:"bal oldalon pedig az adott tárgy által előidézett",params:[]),(code:20110,indent:0,string:"tulajdonságnövelés/csökkenés.",params:[]),(code:20110,indent:0,string:"Ajánlott mindig a lehető legjobb felszerelést",params:[]),(code:20110,indent:0,string:"rakni mindenkire!",params:[]),(code:10110,indent:0,string:"Az Állásmentés menüpont csak a világtérképen",params:[]),(code:20110,indent:0,string:"működik. Ezzel tudod elmenteni a játékállást,",params:[]),(code:20110,indent:0,string:"hogy később betöltve folytathasd a játékot.",params:[]),(code:10110,indent:0,string:"A Kilépés menüpont egyértelmű, kilépés a játékból.",params:[]),(code:20110,indent:0,string:"Ugyanerre szolgál még az F12-es billentyű is.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Lényegében ennyi...\"",params:[]),(code:0,indent:0,string:"",params:[])])])])