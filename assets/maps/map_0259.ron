",params:[]),(code:20110,indent:0,string:"\"Mondjuk az első kettőre már valószínűleg",params:[]),(code:20110,indent:0,string:"rájöttél, különben nem lennél itt és én se tudnék",params:[]),(code:20110,indent:0,string:"beszélni hozzád...\"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:7,x:16,y:8,name:"EV0007",pages:[(trigger:0,graphic_name:"Chara1",graphic_index:6,direction:3,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"A játék során rengeteg \'Nem Játékos Karakterrel\'",params:[]),(code:20110,indent:0,string:"(továbbiakban NJK) és \'Játékos Karakterekkel\'",params:[]),(code:20110,indent:0,string:"(továbbiakban JK) fogsz összefutni.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Én például NJK vagyok, mert nem tudsz",params:[]),(code:20110,indent:0,string:"beválasztani a csapatodba, de lesz jópár olyan",params:[]),(code:20110,indent:0,string:"karakter, aki csatlakozni fog hozzád.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Próbálj meg mindenkivel beszélni, akár",params:[]),(code:20110,indent:0,string:"többször is! Ha most megint beszélsz hozzám,",params:[]),(code:20110,indent:0,string:"akkor mást fogok mondani...\"",params:[]),(code:10210,indent:0,string:"",params:[0,579,579,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"Chara1",graphic_index:6,direction:3,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:1,switch_a:579,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Na ugye, hogy mást mondok?\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Ismételjem meg a mondókám?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Igen/Nem",params:[2]),(code:20140,indent:0,string:"Igen",params:[0]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"Férfi",params:[]),(code:20110,indent:1,string:"\"A játék során rengeteg \'Nem Játékos Karakterrel\'",params:[]),(code:20110,indent:1,string:"(továbbiakban NJK) és \'Játékos Karakterekkel\'",params:[]),(code:20110,indent:1,string:"(továbbiakban JK) fogsz összefutni.\"",params:[]),(code:10110,indent:1,string:"Férfi",params:[]),(code:20110,indent:1,string:"\"Én például NJK vagyok, mert nem tudsz",params:[]),(code:20110,indent:1,string:"beválasztani a csapatodba, de lesz jópár olyan",params:[]),(code:20110,indent:1,string:"karakter, aki csatlakozni fog hozzád.\"",params:[]),(code:10110,indent:1,string:"Férfi",params:[]),(code:20110,indent:1,string:"\"Próbálj meg mindenkivel beszélni, akár",params:[]),(code:20110,indent:1,string:"többször is!\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Nem",params:[1]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:8,x:3,y:6,name:"FogadoLe",pages:[(trigger:1,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:0,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:11330,indent:0,string:"",params:[10001,8,0,0,15]),(code:11410,indent:0,string:"",params:[1]),(code:11550,indent:0,string:"Movement",params:[80,100,50]),(code:11010,indent:0,string:"",params:[0]),(code:11330,indent:0,string:"",params:[10001,8,0,0,13]),(code:11410,indent:0,string:"",params:[1]),(code:10810,indent:0,string:"",params