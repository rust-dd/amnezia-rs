,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nem tudom, hogy az elméletem",params:[]),(code:20110,indent:0,string:"mennyiben helyes, de egyre több",params:[]),(code:20110,indent:0,string:"dolog utal arra, hogy az...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Nyögd már ki! Miféle elmélet?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nincsen semmiféle titokzatos",params:[]),(code:20110,indent:0,string:"császár...\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:11330,indent:0,string:"",params:[8,8,0,0,28,28,26,24,0,2,25,27,29,29]),(code:11330,indent:0,string:"",params:[9,8,0,0,28,28,26,24,0,2,25,27,29,29]),(code:11330,indent:0,string:"",params:[10,8,0,0,28,28,26,24,0,2,25,27,29,29]),(code:11330,indent:0,string:"",params:[11,8,0,0,28,28,26,24,0,2,25,27,29,29]),(code:11330,indent:0,string:"",params:[12,8,0,0,28,28,26,24,0,2,25,27,29,29]),(code:10110,indent:0,string:"Mindenki",params:[]),(code:20110,indent:0,string:"\"Mi???\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Minden jel erre utal...\"",params:[]),(code:11330,indent:0,string:"",params:[5,8,0,0,15]),(code:11330,indent:0,string:"",params:[10001,8,0,0,13]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"\\N[1]! Mikor történt az az",params:[]),(code:20110,indent:0,string:"esemény, amikor elvesztetted az",params:[]),(code:20110,indent:0,string:"emlékezeted?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Öhmm... 3 éve...\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,14]),(code:11330,indent:0,string:"",params:[5,8,0,0,14]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"És...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Tif! Mikor égették le Stern-t?\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"3 éve...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Jó-jó, de ezt eddig is tudtuk...",params:[]),(code:20110,indent:0,string:"Tif és Ron együtt voltak Stern-ben,",params:[]),(code:20110,indent:0,string:"amikor azt leégették...\"",params:[]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Én is ott voltam...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Igen.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"És mióta létezik a birodalmi",params:[]),(code:20110,indent:0,string:"császárság?\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Mindenki",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"3 éve...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Pontosan! 3 éve! Szerintetek",params:[]),(code:20110,indent:0,string:"ez mind véletlen egybeesés?\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"De... nem azt mondtad, hogy már",params:[]),(code:20110,indent:0,string:"régóta a császárságnak dolgozol?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"De igen. Valószínűleg valamilyen",params:[]),(code:20110,indent:0,string:"emlék-torzító szerkezettel kezeltek",params:[]),(code:20110,indent:0,string:"minket...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Beszéltem ugyanis a",params:[]),(code:20110,indent:0,string:"katonákkal, és egyiküknek se",params:[]),(code:20110,indent:0,string:"volt igazi 3 évvel ezelőtti emléke...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Mindenki azt mondta, hogy a",params:[]),(code:20110,indent:0,string:"császárságnál volt már korábban is,",params:[]),(code:20110,indent:0,string:"de konkrét emléke senkinek se volt!\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Ezek szerint... Maga a császárság",params:[]),(code:20110,indent:0,string:"csak valamilyen álca?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Pontosan... Reméltem, hogy ezt",params:[]),(code:20110,indent:0,string:"más mondja ki helyettem...\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"De... Miért alkották meg ezt az",params:[]),(code:20110,indent:0,string:"álcát, és kik?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Valószínűleg az, aki elindította",params:[]),(code:20110,indent:0,string:"a lenti ajtón a nyitómechanizmust...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"De Miért?...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Túl sok a miért, és nincs elég",params:[]),(code:20110,indent:0,string:"válasz...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Tif... Emlékszel, hogy miért",params:[]),(code:20110,indent:0,string:"gyújtották fel a falutokat?\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Nem...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Szerintem a következő történt...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Van egy ember, de méginkább",params:[]),(code:20110,indent:0,string:"őrült, aki jó pár éve felfedezte ezt",params:[]),(code:20110,indent:0,string:"az ajtót a kastély alatt...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nem tudom, hogy miért",params:[]),(code:20110,indent:0,string:"akarja kinyitni, de mindent",params:[]),(code:20110,indent:0,string:"megtesz ezért...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Rájött, hogy a kinyitáshoz",params:[]),(code:20110,indent:0,string:"szükség van valamilyen",params:[]),(code:20110,indent:0,string:"tárgyra...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"A nyakláncom...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Így van. De a nyaklánc nem elég,",params:[]),(code:20110,indent:0,string:"kellenek hozzá a nyitószavak is.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Aztán évek kitartó munkájával",params:[]),(code:20110,indent:0,string:"valahol megtalálja a nyakláncot,",params:[]),(code:20110,indent:0,string:"amit rögtön elszállíttat ide.\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Útközben azonban rablók",params:[]),(code:20110,indent:0,string:"támadják meg a csoportot...\"",params:[]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Igen, emlékszem... Amikor még",params:[]),(code:20110,indent:0,string:"gyerek voltam, akkor mesélték",params:[]),(code:20110,indent:0,string:"nekem az esetet...\"",params:[]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Egy csomó lemészárolt katona",params:[]),(code:20110,indent:0,string:"és rabló holttestére bukkantak",params:[]),(code:20110,indent:0,string:"valahol egy erdőben...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Stern mellett... Igen... Kezd",params:[]),(code:20110,indent:0,string:"derengeni...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Éppen az erdőben kerestem",params:[]),(code:20110,indent:0,string:"valamit, amikor megláttam",params:[]),(code:20110,indent:0,string:"őket... Holtan...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Odamentem... Elvettem a",params:[]),(code:20110,indent:0,string:"nyakláncot, és...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[4,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Elfutottam...\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,2]),(code:10130,indent:0,string:"Ron",par