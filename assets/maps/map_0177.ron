Daren",params:[]),(code:20110,indent:0,string:"\"Hmmm...\"",params:[]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Igen... Csak így történhetett...",params:[]),(code:20110,indent:0,string:"De...\"",params:[]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"\\N[1] miért ölte meg Tif",params:[]),(code:20110,indent:0,string:"szüleit? Amikor először láttam,",params:[]),(code:20110,indent:0,string:"akkor még a katonákkal harcolt...\"",params:[]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Utána meg már Tif szülei",params:[]),(code:20110,indent:0,string:"fölött áll, véres pengékkel...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,15]),(code:11410,indent:0,string:"",params:[1]),(code:11330,indent:0,string:"",params:[10001,8,0,0,12]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Miért?... Miért nem emlékszem",params:[]),(code:20110,indent:0,string:"semmire?...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Sok kérdés megválaszolatlan",params:[]),(code:20110,indent:0,string:"még, de ha elkapjuk ezt az őrültet,",params:[]),(code:20110,indent:0,string:"akkor mindent kiszedünk belőle...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Most szerintem keressünk egy",params:[]),(code:20110,indent:0,string:"helyet, ahol pihenhetünk, és",params:[]),(code:20110,indent:0,string:"holnap folytatjuk a keresést...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Az ajtón lévő időzár szerint",params:[]),(code:20110,indent:0,string:"még 3 napunk van a kinyílásig.\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Igazad van... Mindannyiónkra",params:[]),(code:20110,indent:0,string:"ránkfér a pihenés, de főleg Tif-re",params:[]),(code:20110,indent:0,string:"és \\N[1]-ra...\"",params:[]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Túl sok tárult fel a múltból...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Úgy láttam, hogy a kastélyban",params:[]),(code:20110,indent:0,string:"elég sok lakószoba van. Szerintem",params:[]),(code:20110,indent:0,string:"mindenki foglaljon el egyet...\"",params:[]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Az ajtók zárhatóak, nem tudnak",params:[]),(code:20110,indent:0,string:"megtámadni a szobában...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Helyes. Egyedül mindenesetre",params:[]),(code:20110,indent:0,string:"senki se csatangoljon, mert úgy",params:[]),(code:20110,indent:0,string:"könnyű préda az őrültnek...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Ha egyáltalán itt van a",params:[]),(code:20110,indent:0,string:"kastélyban...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Na igen. De azért nem árt az",params:[]),(code:20110,indent:0,string:"óvatosság...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"\\N[1]?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[4,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]