,(code:20110,indent:0,string:"\"Hmmm... A kapitány naplójának",params:[]),(code:20110,indent:0,string:"egy lapja...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'Első nap: Jobban is indulhatott",params:[]),(code:20110,indent:0,string:"volna az út... Rögtön a kihajózás",params:[]),(code:20110,indent:0,string:"után elkapott minket a vihar.\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Szerencsére a matrózok",params:[]),(code:20110,indent:0,string:"derekasan helytálltak, és így",params:[]),(code:20110,indent:0,string:"viszonylag épségben hagytuk el\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"a viharzónát. Az út további",params:[]),(code:20110,indent:0,string:"része egyelőre nyugodt volt.\'\"",params:[]),(code:10220,indent:0,string:"",params:[0,67,67,1,0,1,0]),(code:10210,indent:0,string:"",params:[0,507,507,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:143,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:4,switch_a:0,switch_b:0,variable_id:67,variable_value:1,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Egy újabb napló-lap...\"",params:[]),(code:11330,indent:0,string:"",params:[10005,8,0,0,34,5,84,111,114,99,104,1]),(code:11410,indent:0,string:"",params:[10]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'Második nap: Eltűnt egy matróz!",params:[]),(code:20110,indent:0,string:"Valószínűleg a tegnapi viharban",params:[]),(code:20110,indent:0,string:"esett a vízbe... Béke poraira.\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Az utasok jól bírják az utat,",params:[]),(code:20110,indent:0,string:"eddig még senki sem panaszkodott.",params:[]),(code:20110,indent:0,string:"Ez kifejezetten ritkaság.\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Remélem a holnapi nap is",params:[]),(code:20110,indent:0,string:"nyugodt lesz.\'\"",params:[]),(code:10220,indent:0,string:"",params:[0,67,67,1,0,1,0]),(code:10210,indent:0,string:"",params:[0,507,507,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:143,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:4,switch_a:0,switch_b:0,variable_id:67,variable_value:2,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Egy újabb napló-lap...\"",params:[]),(code:11330,indent:0,string:"",params:[10005,8,0,0,34,5,84,111,114,99,104,1]),(code:11410,indent:0,string:"",params:[10]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'Harmadik nap: Az utasok még",params:[]),(code:20110,indent:0,string:"mindig nem panaszkodnak, sőt mi",params:[]),(code:20110,indent:0,string:"több, el se hagyják a kabinukat!\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Ilyen eddig még sose fordult elő,",params:[]),(code:20110,indent:0,string:"remélem a jövőben is hasonló",params:[]),(code:20110,indent:0,string:"utasokat szállítunk majd...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"A matrózok viszont elég",params:[]),(code:20110,indent:0,string:"idegesek, valószínűleg a vízbefúlt",params:[]),(code:20110,indent:0,string:"társuk miatt...\'\"",params:[]),(code:10220,indent:0,string:"",params:[0,67,67,1,0,1,0]),(code:10210,indent:0,string:"",params:[0,507,507,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:143,direction:2,pattern:1,