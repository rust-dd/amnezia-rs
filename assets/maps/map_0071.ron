,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"... Hát ez meg... Mi...\"",params:[]),(code:11410,indent:0,string:"",params:[10]),(code:11330,indent:0,string:"",params:[10001,8,0,0,3,3,3,3,2,2,3,3,3]),(code:11410,indent:0,string:"",params:[18]),(code:11330,indent:0,string:"",params:[10005,8,0,0,13]),(code:11410,indent:0,string:"",params:[1]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Stan, mi a csuda ez?\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:10110,indent:0,string:"Stan",params:[]),(code:20110,indent:0,string:"\"Fogalmam sincs... Még sose láttam ilyet...\"",params:[]),(code:11330,indent:0,string:"",params:[10005,8,0,0,12]),(code:11330,indent:0,string:"",params:[10001,8,0,0,12]),(code:11410,indent:0,string:"",params:[1]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:11410,indent:0,string:"",params:[10]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"\\N[1]!\"",params:[]),(code:11330,indent:0,string:"",params:[31,8,0,0,13]),(code:11330,indent:0,string:"",params:[10001,8,0,0,15]),(code:11060,indent:0,string:"",params:[2,3,5,4,0]),(code:11410,indent:0,string:"",params:[5]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Gyere le egy kicsit!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Megyek.\"",params:[]),(code:11030,indent:0,string:"",params:[0,0,0,100,5,1]),(code:11060,indent:0,string:"",params:[3,0,1,4,1]),(code:10810,indent:0,string:"",params:[71,24,16]),(code:11130,indent:0,string:"",params:[1]),(code:10210,indent:0,string:"",params:[0,186,186,0]),(code:11410,indent:0,string:"",params:[10]),(code:11030,indent:0,string:"",params:[100,100,100,100,5,1]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Figyelj, \\N[1]! Ki ez a Tiffany?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mondtam már, egy énekeslány.\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Na ezt ne próbáld meg beadni",params:[]),(code:20110,indent:0,string:"nekem! Akkor miért van a császár",params:[]),(code:20110,indent:0,string:"a nyomában?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[5,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"A császár???\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Igen. Nem tudom, hogy mi volt",params:[]),(code:20110,indent:0,string:"ez, ami elhaladt felettünk, de a Thorn",params:[]),(code:20110,indent:0,string:"Császárság jele volt az oldalán...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"... Nem értem...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Hát én se! És amilyen tempóval",params:[]),(code:20110,indent:0,string:"haladtak, hamarabb utolérik a",params:[]),(code:20110,indent:0,string:"Stalliont, mint mi...\"",params:[]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Figyelj, mindent megpróbálunk, hogy",params:[]),(code:20110,indent:0,string:"beérjük őket, de nem biztos, hogy",params:[]),(code:20110,indent:0,string:"sikerül...\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,34,6,80,111,115,101,115,50,0,12]),(code:11410,indent:0,string:"",params:[1]),(code:10130,indent:0,string