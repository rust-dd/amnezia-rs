:0,string:"\"Hmmm... Nincs értelme tovább",params:[]),(code:20110,indent:0,string:"titkolnom...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Mit?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"A Tribal-ok idejében az a kastély",params:[]),(code:20110,indent:0,string:"volt a központ. Mindent onnan",params:[]),(code:20110,indent:0,string:"irányítottak.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nem tudom, mi található amögött",params:[]),(code:20110,indent:0,string:"az ajtó mögött, amit nem tudtunk",params:[]),(code:20110,indent:0,string:"kinyitni, de nagyon fontos lehet...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Elképzelhető, hogy valamilyen",params:[]),(code:20110,indent:0,string:"fegyvert rejtettek oda.\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"És ha rossz kezekbe kerül...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Arra még gondolni is rossz...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Márpedig most nagyon úgy néz ki...",params:[]),(code:20110,indent:0,string:"Csak egy valamit nem értek...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"???\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Ha a sejtéseink helyesek, akkor",params:[]),(code:20110,indent:0,string:"Tif nyaklánca a kulcs mindenhez. De",params:[]),(code:20110,indent:0,string:"hogy sikerült kinyitni őket nélküle?\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[5,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Úristen... Ott hagytam a",params:[]),(code:20110,indent:0,string:"nyakláncom a kórházban...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Ezek szerint valaki elvitte onnan,",params:[]),(code:20110,indent:0,string:"és beindította a lebegtetőgépet...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Akkor semmit se tehetünk... Biztos",params:[]),(code:20110,indent:0,string:"az ajtót is kinyitotta már...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nem...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Ugyan az ajtót nem tudtuk kinyitni,",params:[]),(code:20110,indent:0,string:"de azt megfigyeltük, hogy valamilyen",params:[]),(code:20110,indent:0,string:"időzár is védi...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Vagyis?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"A nyitószerkezet a működésbe",params:[]),(code:20110,indent:0,string:"lépést követően jópár nap múlva",params:[]),(code:20110,indent:0,string:"nyitja ki az ajtót.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Legalábbis erre tippeltünk...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Ezek szerint még van pár",params:[]),(code:20110,indent:0,string:"napunk.\"",params:[]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Nem tudom, ti hogy vagytok vele,",params:[]),(code:20110,indent:0,string:"de nekem semmi kedvem egy őrült",params:[]),(code:20110,indent:0,string:"által irányított világban élni...\"",params:[]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Mert... Mondjuk ki... Valószínűleg",params:[]),(code:20110,indent:0,string:"őrülttel van dolgunk.\"",params:[]),(code:12010,indent:0,string:"",params:[0,323,0,0,0,0]),(code:10110,indent:1,string:"Alen",params:[]),(code:20110,indent:1,string:"\"Stan-t is megölte...\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Igen... Minden kétséget kizáróan",params:[]),(code:20110,indent:0,string:"őrült a fickó...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Akkor... Mit csináljunk?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Felmegyünk a kastélyba, és",params:[]),(code:20110,indent:0,string:"megakadályozzuk, hogy kinyíljon",params:[]),(code:20110,indent:0,string:"az ajtó...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Stark, fel tudsz repülni a",params:[]),(code:20110,indent:0,string:"Draco-val?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Bízd csak rám!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Rendben...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Emberek, ez egy veszélyes harc",params:[]),(code:20110,indent:0,string:"lesz, aki akar, az még most",params:[]),(code:20110,indent:0,string:"kiléphet...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Ne hülyéskedj... Nem futamodunk",params:[]),(code:20110,indent:0,string:"meg!\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"A mi érdekünk is, hogy ne nyíljon",params:[]),(code:20110,indent:0,string:"ki a kapu...\"",params:[]),(code:10130,indent:0,string:"Stella",params:[1,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Én se hátrálok meg...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Én tehetek róla, hogy egyáltalán",params:[]),(code:20110,indent:0,string:"el tudta indítani a gépet... Én is",params:[]),(code:20110,indent:0,string:"megyek!\"",params:[]),(code:10130,indent:0,string:"Chara1",params:[2,0,0]),(code:10110,indent:0,string:"Tray",params:[]),(code:20110,indent:0,string:"\"Ennyivel tartozom...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nélkülem meg fel se jutnátok...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Köszönöm... Mindanny