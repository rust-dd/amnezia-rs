oglalat... Foglalat... Mint...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[5,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mint az erődben!!!\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Pontosan... És még valami...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Az a szoba nem volt ott, amíg",params:[]),(code:20110,indent:0,string:"az erődben dolgoztam...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Tehát csak utólag építették",params:[]),(code:20110,indent:0,string:"oda... De miért?...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nem tudom...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hmmm... Mindegy, egyenlőre",params:[]),(code:20110,indent:0,string:"vigyük haza Tray-t, aztán utána",params:[]),(code:20110,indent:0,string:"elgondolkodunk ezen a dolgon...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Rendben.\"",params:[]),(code:11010,indent:0,string:"",params:[0]),(code:10210,indent:0,string:"",params:[0,371,371,0]),(code:11410,indent:0,string:"",params:[1]),(code:10810,indent:0,string:"",params:[13,54,99]),(code:10630,indent:0,string:"Torch",params:[1,1,0]),(code:10330,indent:0,string:"",params:[1,0,2]),(code:10850,indent:0,string:"",params:[2,0,13,54,99]),(code:10840,indent:0,string:"",params:[]),(code:11330,indent:0,string:"",params:[10004,8,0,0,13]),(code:11410,indent:0,string:"",params:[1]),(code:11020,indent:0,string:"",params:[0]),(code:11330,indent:0,string:"",params:[10004,8,0,