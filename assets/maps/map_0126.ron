ring:"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"(Tényleg... Hol lehet Stan?)\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:10220,indent:0,string:"",params:[0,92,92,1,0,1,0]),(code:10220,indent:0,string:"",params:[0,15,15,1,0,1,0]),(code:10210,indent:0,string:"",params:[0,325,325,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"Chara3",graphic_index:2,direction:1,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:325,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Chara2",params:[2,0,0]),(code:10110,indent:0,string:"Lance",params:[]),(code:20110,indent:0,string:"\"A fene se gondolta, hogy ilyen",params:[]),(code:20110,indent:0,string:"rázós lesz...\"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:1,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:0,condition:(flags:1,switch_a:402,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:0,indent:0,string:"",params:[])])]),(id:24,x:2,y:22,name:"Lance1",pages:[(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:0,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:0,condition:(flags:1,switch_a:309,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:0,indent:0,string:"",params:[])])]),(id:25,x:9,y:25,name:"EV0025",pages:[(trigger:1,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:0,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:11010,indent:0,string:"",params:[0]),(code:10810,indent:0,string:"",params:[125,9,1]),(code:11020,indent:0,string:"",params:[0]),(code:11330,indent:0,string:"",params:[10001,8,0,0,2]),(code:0,indent:0,string:"",params:[])])]),(id:26,x:10,y:25,name:"EV0026",pages:[(trigger:1,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:0,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:11010,indent:0,string:"",params:[0]),(code:10810,indent:0,string:"",params:[125,10,1]),(code:11020,indent:0,string:"",params:[0]),(code:11330,indent:0,string:"",params:[10001,8,0,0,2]),(code:0,indent:0,string:"",params:[])])]),(id:27,x:9,y:9,name:"Stark",pages:[(trigger:3,graphic_name:"Chara2",graphic_index:2,direction:0,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:312,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:11410,indent:0,string:"",params:[20]),(code:11330,indent:0,string:"",params:[10005,8,0,0,13]),(code:10440,indent:0,string:"",params:[1,8,0,0,41]),(code:10440,indent:0,string:"",params:[1,8,0,0,42]),(code:11410,indent:0,string:"",params:[1]),(code:11330,indent:0,string:"",params:[10005,8,0,0,14]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"No, ha minden jó, akkor meg",params:[]),(code:20110,indent:0,string:"sem állunk Stern-ig...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[1,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Hihetetlen... Bárki is csinálta",params:[]),(code:20110,indent:0,string:"ezt a léghajót, nagy koponya",params:[]),(code:20110,indent:0,string:"lehetett...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Tényleg, Stark, honnan van",params:[]),(code:20110,indent:0,string:"ez a léghajó? Ki építette?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Hmmm, hát jó. Elmondom.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Gondolom mindenki előtt nyílvánvaló,",params:[]),(code:20110,indent:0,string:"hogy én a Császárságnak dolgoztam.\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Persze. Aztán valamiért",params:[]),(code:20110,indent:0,string:"börtönbe zártak.\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Igen. Arra is kitérek mindjárt.",params:[]),(code:20110,indent:0,string:"Szóval mielőtt pilóta lettem,",params:[]),(code:20110,indent:0,string:"egy kutatócsoportban dolgoztam.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Az volt a feladatunk, hogy a",params:[]),(code:20110,indent:0,string:"Tribal-ok után kutassunk.\"",params:[]),(code:10130,indent:0,string:"Stella",params:[0,0,0]),(code:10110,indent:0,string:"Stella",params:[]),(code:20110,indent:0,string:"\"Tribal-ok? Azok mik?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Inkább kik... Ők voltak az",params:[]),(code:20110,indent:0,string:"előttünk élő emberek a földön,",params:[]),(code:20110,indent:0,string:"csak valami miatt mind eltűntek.\"",params:[]),(code:10130,indent:0,string:"Daren",params:[1,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Érdekes... Ők építették ezt a",params:[]),(code:20110,indent:0,string:"léghajót is?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Igen. Sok mindennel egyetemben",params:[]),(code:20110,indent:0,string:"ezt a léghajót is egy föld alatti",params:[]),(code:20110,indent:0,string:"raktárban találtuk.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Furcsa... Miért nem hallottam",params:[]),(code:20110,indent:0,string:"a Tribal-okról soha?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Azért, mert a Császárság minden",params:[]),(code:20110,indent:0,string:"információt visszatartott.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Minden Tribal-okról szóló vagy",params:[]),(code:20110,indent:0,string:"egyáltalán rájuk utaló könyvet",params:[]),(code:20110,indent:0,string:"megsemmisítettek...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hmmm, értem...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Oké, eddig világos. De miért",params:[]),(code:20110,indent:0,string:"zártak börtönbe?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Mert... Rájöttem mi áll e",params:[]),(code:20110,indent:0,string:"mögött a nagy kutatás mögött...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Mi?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Fegyverkezés...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Gondolom láttátok, hogy milyen",params:[]),(code:20110,indent:0,string:"fegyverem van. Na ez is Tribal",params:[]),(code:20110,indent:0,string:"gyártmány.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Ha a Császárság ráteszi a kezét",params:[]),(code:20110,indent:0,string:"a Tribal-ok fegyvereire, annak",params:[]),(code:20110,indent:0,string:"beláthatatlan következményei lesznek.\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"És gondolom te szabotáltad a",params:[]),(code:20110,indent:0,string:"műveletet...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Igen. Berobbantottam a raktár",params:[]),(code:20110,indent:0,string:"bejáratát.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hol van ez a raktárbarlang?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"A császársági szigetcsoporttól",params:[]),(code:20110,indent:0,string:"nyugatra.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10130,indent:0,string:"Alen",params:[0,0,0]),(code:10110,indent:0,string:"Alen",params:[]),(code:20110,indent:0,string:"\"Szinte hihetetlen... Egy régi kor,",params:[]),(code:20110,indent:0,string:"ami sokkal fejlettebb volt, mint a",params:[]),(code:20110,indent:0,string:"miénk...\"",params:[]),(code:10130,indent:0,string:"Daren",params:[0,0,0]),(code:10110,indent:0,string:"Daren",params:[]),(code:20110,indent:0,string:"\"Kíváncsi vagyok, mi lett a",params:[]),(code:20110,indent:0,string:"Tribal-okkal...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Na igen. Ezek azok a kérdések,",params:[]),(code:20110,indent:0,string:"amikre talán csak maga a császár",params:[]),(code:20110,indent:0,string:"tudja a választ...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hmmm... Stark, mikor érünk",params:[]),(code:20110,indent:0,string:"Stern-be?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Nem tudom biztosan.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Akkor szerintem ledőlök egy",params:[]),(code:20110,indent:0,string:"kicsit, eléggé hasogat a fejem...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Oké, szólok, ha bármi van.\"",params:[]),(code:11520,indent:0,string:"",params:[3000]),(code:11030,indent:0,string:"",params:[0,0,0,100,20,1]),(code:11410,indent:0,string:"",params:[30]),(code:11510,indent:0,string:"(OFF)",params:[0,100,100,50]),(code:11410,indent:0,string:"",params:[10]),(code:10210,indent:0,string:"",params:[0,315,315,0]),(code:11330,indent:0,string:"",params:[10001,8,0,0,14]),(code:10120,indent:0,string:"",params:[1,2,1,1]),(code:10810,indent:0,string:"",params:[86,10,7]),(code:10210,indent:0,string:"",params:[0,313,313,0]),(code:11510,indent:0,string:"Memories",params:[0,80,100,50]),(code:11030,indent:0,string:"",p