arams:[]),(code:10110,indent:0,string:"Tray",params:[]),(code:20110,indent:0,string:"\"Én csak szeretnék mielőbb hazajutni.",params:[]),(code:20110,indent:0,string:"Végülis nem köt semmi hozzátok...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Igen, kétségtelenül igazad van...\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,12]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Stark! Menjünk vissza Tyran-ba!\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Jól van.\"",params:[]),(code:12010,indent:0,string:"",params:[0,323,1,0,0,0]),(code:11330,indent:1,string:"",params:[56,8,0,0,2,2,2,34,5,84,111,114,99,104,1]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:11330,indent:0,string:"",params:[57,8,0,0,2,2,2,2,34,5,84,111,114,99,104,1,2,3,3,3,3]),(code:11330,indent:0,string:"",params:[58,8,0,0,2,2,2,2,34,5,84,111,114,99,104,1,2,3,3,3]),(code:11330,indent:0,string:"",params:[51,8,0,0,2,2,2,2,2,2,2,2,34,5,84,111,114,99,104,1,2,3,3,3]),(code:11330,indent:0,string:"",params:[53,8,0,0,1,2,2,2,2,2,2,2,2,34,5,84,111,114,99,104,1,2,3,3]),(code:11330,indent:0,string:"",params:[59,8,0,0,3,2,2,2,2,2,2,2,2,34,5,84,111,114,99,104,1,2,1,1,1,1]),(code:11330,indent:0,string:"",params:[35,8,0,0,2,2,2,34,5,84,111,114,99,104,1,2,1,1,0]),(code:11330,indent:0,string:"",params:[60,8,0,0,2,2,2,2,34,5,84,111,114,99,104,1]),(code:11330,indent:0,string:"",params:[30,8,0,0,2,15,23,23,3,2,2,2,2,2,2,2,2,34,5,84,111,114,99,104,1,2,1,1,1]),(code:11330,indent:0,string:"",params:[33,8,0,0,2,13,23,1,1,2,2,2,2,2,2,2,2,2,34,5,84,111,114,99,104,1,2,1,1]),(code:11330,indent:0,string:"",params:[28,8,0,0,3,3,3]),(code:11330,indent:0,string:"",params:[54,8,0,0,14,23,2,2,2,2,2,2,2,2,34,5,84,111,114,99,104,1,1]),(code:11330,indent:0,str