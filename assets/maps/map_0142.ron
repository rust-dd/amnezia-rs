eat:false,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'Tribal technológiák\'\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"A könyv egy furcsa, csillag alakú",params:[]),(code:20110,indent:0,string:"zárral le van pecsételve...\"",params:[]),(code:12010,indent:0,string:"",params:[4,201,0,0,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Esetleg... A csillagtárgy mintha",params:[]),(code:20110,indent:1,string:"beleillene...\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:11550,indent:1,string:"Key",params:[90,100,50]),(code:10110,indent:1,string:"**\\N[1] kinyitotta a könyvzárat!**",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Beleolvasok/Most nem érdekel",params:[2]),(code:20140,indent:1,string:"Beleolvasok",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"Emlék manipulátor",params:[]),(code:20110,indent:2,string:"\"Az alanyt rákötjük a központi egységre, és ennek",params:[]),(code:20110,indent:2,string:"segítségével bármit bele tudunk \"írni\" az agyába.",params:[]),(code:20110,indent:2,string:"Vagy akár ki is törölhetünk onnan valamit...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most elég ennyi",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10130,indent:3,string:"",params:[0,0,0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most elég ennyi",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10110,indent:2,string:"Hipnotizáló gépezet",params:[]),(code:20110,indent:2,string:"\"Jelenleg még csak kísérleti stádiumban van, és",params:[]),(code:20110,indent:2,string:"méreteit tekintve is nagyon nagy szerkezet, de",params:[]),(code:20110,indent:2,string:"segítségével képesek vagyunk bárkit",params:[]),(code:10110,indent:2,string:"hipnotizálni, és így irányítani, ha belenéz a",params:[]),(code:20110,indent:2,string:"gép optikájába.\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most elég ennyi",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10130,indent:3,string:"",params:[0,0,0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most elég ennyi",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10110,indent:2,string:"Anti-gravitációs Emelő",params:[]),(code:20110,indent:2,string:"\"Ennek segítségével bármit a levegőbe tudunk",params:[]),(code:20110,indent:2,string:"emelni, súlytól, tömegtől függetlenül. Lásd még:",params:[]),(code:20110,indent:2,string:"Aeropolis\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most elég ennyi",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10130,indent:3,string:"",params:[0,0,0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most elég ennyi",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10110,indent:2,string:"Lőfegyverek",params:[]),(code:20110,indent:2,string:"\"Olyan harcászati eszközeink, melyekkel sokkalta",params:[]),(code:20110,indent:2,string:"nagyobb pusztítást végezhetünk, mint képzelnénk.",params:[]),(code:20110,indent:2,string:"A golyónak semmilyen élő szövet nem állja útját.\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most elég ennyi",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10130,indent:3,string:"",params:[0,0,0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most elég ennyi",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10110,indent:2,string:"Életenergiaelszívó",params:[]),(code:20110,indent:2,string:"\"Az örök élet forrása. Ennek segítségével",params:[]),(code:20110,indent:2,string:"elszívhatjuk környezetünk életenergiáját, és",params:[]),(code:20110,indent:2,string:"magunkba sugározva azt, felújíthatjuk testünk",params:[]),(code:10110,indent:2,string:"szükségleteit. Ezzel megállíthatjuk az öregedést,",params:[]),(code:20110,indent:2,string:"de állandó energiafenntartás szükséges, különben",params:[]),(code:20110,indent:2,string:"a testünk nem képes életben maradni, és perceken",params:[]),(code:20110,indent:2,string:"belül meghalunk...",params:[]),(code:10110,indent:2,string:"A szükséges életadag: napi 1 dózis.\"",params:[]),(code:10130,indent:2,string:"Ron",params:[5,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Atyaég... Ennyi elég ebből...\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most nem érdekel",params:[1]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:12110,indent:1,string:"",params:[100]),(code:10210,indent:1,string:"",params:[0,609,609,0]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route: