e:10110,indent:1,string:"Életenergiaelszívó",params:[]),(code:20110,indent:1,string:"\"Az örök élet forrása. Ennek segítségével",params:[]),(code:20110,indent:1,string:"elszívhatjuk környezetünk életenergiáját, és",params:[]),(code:20110,indent:1,string:"magunkba sugározva azt, felújíthatjuk testünk",params:[]),(code:10110,indent:1,string:"szükségleteit. Ezzel megállíthatjuk az öregedést,",params:[]),(code:20110,indent:1,string:"de állandó energiafenntartás szükséges, különben",params:[]),(code:20110,indent:1,string:"a testünk nem képes életben maradni, és perceken",params:[]),(code:20110,indent:1,string:"belül meghalunk...",params:[]),(code:10110,indent:1,string:"A szükséges életadag: napi 1 dózis.\"",params:[]),(code:10130,indent:1,string:"Ron",params:[5,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Atyaég... Ennyi elég ebből...\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Most nem érdekel",params:[1]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:9,x:15,y:5,name:"EV0009",pages:[(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'A Felsőbb Tudás Birtokosai\'\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"A könyv egy furcsa, csillag alakú",params:[]),(code:20110,indent:0,string:"zárral le van pecsételve...\"",params:[]),(code:12010,indent:0,string:"",params:[4,201,0,0,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Esetleg... A csillagtárgy mintha",params:[]),(code:20110,indent:1,string:"beleillene...\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:11550,indent:1,string:"Key",params:[90,100,50]),(code:10110,indent:1,string:"**\\N[1] kinyitotta a könyvzárat!**",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Beleolvasok/Most nem érdekel",params:[2]),(code:20140,indent:1,string:"Beleolvasok",params:[0]),(code:10210,indent:2,string:"",params:[0,613,613,0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"\"Társaságunkat azért alapítottuk, hogy a Világ",params:[]),(code:20110,indent:2,string:"legintelligensebb embereit összegyűjthessük,",params:[]),(code:20110,indent:2,string:"és együtt kamatoztathassuk tudásunkat. A",params:[]),(code:20110,indent:2,string:"felvételi különösen nehéz, hiszen ide csakis a",params:[]),(code:10110,indent:2,string:"legmagasabb IQ-val, legmélyebb tárgyi és szellemi",params:[]),(code:20110,indent:2,string:"tudással rendelkezők juthatnak be. Legfőbb",params:[]),(code:20110,indent:2,string:"célunk, hogy megtaláljuk az Örök Élet titkát,",params:[]),(code:20110,indent:2,string:"hogy az öregedést megállítva felülemelkedjünk",params:[]),(code:10110,indent:2,string:"halandó létünkön. Ilyen mértékű tudásnak",params:[]),(code:20110,indent:2,string:"nem szabad eltűnnie, nem szabad hagynunk,",params:[]),(code:20110,indent:2,string:"hogy testünk legyőzze lelkünket!\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Hmmm, innentől kezdve üresek",params:[]),(code:20110,indent:2,string:"az oldalak, kivéve az utolsót:\"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"\"Megtaláltuk! Mától kezdve már nem sorolhatnak",params:[]),(code:20110,indent:2,string:"minket a primitív emberek közé! Többek vagyunk",params:[]),(code:20110,indent:2,string:"náluk, mi vagyunk a Felsőbbrendű Nép, a Tribal...\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most nem érdekel",params:[1]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:12110,indent:1,string:"",params:[100]),(code:10210,indent:1,string:"",params:[0,609,609,0]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:1,switch_a:609,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'A Felsőbb Tudás Birtokosai\'\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Beleolvasok/Most nem érdekel",params:[2]),(code:20140,indent:0,string:"Beleolvasok",params:[0]),(code:10210,indent:1,string:"",params:[0,613,613,0]),(code:11550,indent:1,string:"Key",params:[90,100,50]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"\"Társaságunkat azért alapítottuk, hogy a Világ",params:[]),(code:20110,indent:1,string:"legintelligensebb embereit összegyűjthessük,",params:[]),(code:20110,indent:1,string:"és együtt kamatoztathassuk tudásunkat. A",params:[]),(code:20110,indent:1,string:"felvételi különösen nehéz, hiszen ide csakis a",params:[]),(code:10110,indent:1,string:"legmagasabb IQ-val, legmélyebb tárgyi és szellemi",params:[]),(code:20110,indent:1,string:"tudással rendelkezők juthatnak be. Legfőbb",params:[]),(code:20110,indent:1,string:"célunk, hogy megtaláljuk az Örök Élet titkát,",params:[]),(code:20110,indent:1,string:"hogy az öregedést megállítva felülemelkedjünk",params:[]),(code:10110,indent:1,string:"halandó létünkön. Ilyen mértékű tudásnak",params:[]),(code:20110,indent:1,string:"nem szabad eltűnnie, nem szabad hagynunk,",params:[]),(code:20110,indent:1,string:"hogy testünk legyőzze lelkünket!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Hmmm, innentől kezdve üresek",params:[]),(code:20110,indent:1,string:"az oldalak, kivéve az utolsót:\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"\"Megtaláltuk! Mától kezdve már nem sorolhatnak",params:[]),(code:20110,indent:1,string:"minket a primitív emberek közé! Többek vagyunk",params:[]),(code:20110,indent:1,string:"náluk, mi vagyunk a Felsőbbrendű Nép, a Tribal...\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Most nem érdekel",params:[1]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:10,x:12,y:5,name:"EV0010",pages:[(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'A Tárgy és lélek kapcsolata\'\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"A könyv egy furcsa, csillag alakú",params:[]),(code:20110,indent:0,string:"zárral le van pecsételve...\"",params:[]),(code:12010,indent:0,string:"",params:[4,201,0,0,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Esetleg... A csillagtárgy mintha",params:[]),(code:20110,indent:1,string:"beleillene...\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:11550,indent:1,string:"Key",params:[90,100,50]),(code:10110,indent:1,string:"**\\N[1] kinyitotta a könyvzárat!**",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Beleolvasok/Most nem érdekel",params:[2]),(code:20140,indent:1,string:"Beleolvasok",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"\"A tárgyak normális esetben nem kapcsolódnak",params:[]),(code:20110,indent:2,string:"semmihez, átlagobjektumok a Világban.",params:[]),(code:20110,indent:2,string:"Azonban lehetőség van arra, hogy egy tárgyat",params:[]),(code:20110,indent:2,string:"összekapcsoljunk egy ember lelkével, aminek",params:[]),(code:10110,indent:2,string:"eredményeként az ember és a tárgy között szoros",params:[]),(code:20110,indent:2,string:"kapcsolat jön létre. Ha egy ilyen Lélekkapocs",params:[]),(code:20110,indent:2,string:"létrejön, akkor a tárgy onnantól kezdve csak",params:[]),(code:20110,indent:2,string:"annak az embernek a kezében lesz",params:[]),(code:10110,indent:2,string:"használható, akinek a lelkével összekapcsolódott,",params:[]),(code:20110,indent:2,string:"legyen bármi is a rendeltetése.",params:[]),(code:20110,indent:2,string:"A Lélekkapocs létrehozásának módszere:",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Sajnos innentől egy kukkot se",params:[]),(code:20110,indent:2,string:"értek... Továbblapozok, hátha van még",params:[]),(code:20110,indent:2,string:"valami érthető a könyvben...\"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"\"... ezzel megnyílik a lélekkapocs. Aki innentől",params:[]),(code:20110,indent:2,string:"először személyes kontaktust létesít a tárggyal",params:[]),(code:20110,indent:2,string:"(puszta kézzel megérinti), az lesz a kapocs",params:[]),(code:20110,indent:2,string:"másik vége. Ettől fogva a tárgyat rendeltetése",params:[]),(code:10110,indent:2,string:"szerint csak a tárggyal összekapcsolt",params:[]),(code:20110,indent:2,string:"illető használhatja, mindenki más ha kézbe",params:[]),(code:20110,indent:2,string:"veszi, azt se tudja, mit tart a kezében.",params:[]),(code:20110,indent:2,string:"VIGYÁZAT! Ha a tárgy lélekpárja",params:[]),(code:10110,indent:2,string:"meghal anélkül, hogy a kapocs megsemmisülne,",params:[]),(code:20110,indent:2,string:"a tárgy MINDENKI által használhatatlanná",params:[]),(code:20110,indent:2,string:"válik, és semmilyen módszerrel nem lehet",params:[]),(code:20110,indent:2,string:"megszüntetni a szétszakadt lélekkapcsot!",params:[]),(code:10110,indent:2,string:"Az egyetlen lehetséges felbontása a",params:[]),(code:20110,indent:2,string:"Lélekkapocsnak:",params:[]),(code:20110,indent:2,string:"A lélekpárnak fennhangon ki kell mondani a",params:[]),(code:20110,indent:2,string:"kapocsmegszüntető szavakat.",params:[]),(code:10110,indent:2,string:"A szavak:",params:[]),(code:20110,indent:2,string:"Fithos, Lusec, Wecos, Vinosec\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"...\"",params:[]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Ezeket a szavakat mondta Tif",params:[]),(code:20110,indent:2,string:"a trónteremben...\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most nem érdekel",params:[1]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:12110,indent:1,string:"",params:[100]),(code:10210,indent:1,string:"",params:[0,609,609,0]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:1,switch_a:609,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'A Tárgy és lélek kapcsolata\'\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Beleolvasok/Most nem érdekel",params:[2]),(code:20140,indent:0,string:"Beleolvasok",params:[0]),(code:11550,indent:1,string:"Key",params:[90,100,50]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"\"A tárgyak normális esetben nem kapcsolódnak",params:[]),(code:20110,indent:1,string:"semmihez, átlagobjektumok a Világban.",params:[]),(code:20110,indent:1,string:"Azonban lehetőség van arra, hogy egy tárgyat",params:[]),(code:20110,indent:1,string:"összekapcsoljunk egy ember lelkével, aminek",params:[]),(code:10110,indent:1,string:"eredményeként az ember és a tárgy között szoros",params:[]),(code:20110,indent:1,string:"kapcsolat jön létre. Ha egy ilyen Lélekkapocs",params:[]),(code:20110,indent:1,string:"létrejön, akkor a tárgy onnantól kezdve csak",params:[]),(code:20110,indent:1,string:"annak az embernek a kezében lesz",params:[]),(code:10110,indent:1,string:"használható, akinek a lelkével összekapcsolódott,",params:[]),(code:20110,indent:1,string:"legyen bármi is a rendeltetése.",params:[]),(code:20110,indent:1,string:"A Lélekkapocs létrehozásának módszere:\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Sajnos innentől egy kukkot se",params:[]),(code:20110,indent:1,string:"értek... Továbblapozok, hátha van még",params:[]),(code:20110,indent:1,string:"valami érthető a könyvben...\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"\"... ezzel megnyílik a lélekkapocs. Aki innentől",params:[]),(code:20110,indent:1,string:"először személyes kontaktust létesít a tárggyal",params:[]),(code:20110,indent:1,string:"(puszta kézzel megérinti), az lesz a kapocs",params:[]),(code:20110,indent:1,string:"másik vége. Ettől fogva a tárgyat rendeltetése",params:[]),(code:10110,indent:1,string:"szerint csak a tárggyal összekapcsolt",params:[]),(code:20110,indent:1,string:"illető használhatja, mindenki más ha kézbe",params:[]),(code:20110,indent:1,string:"veszi, azt se tudja, mit tart a kezében.",params:[]),(code:20110,indent:1,string:"VIGYÁZAT! Ha a tárgy lélekpárja",params:[]),(code:10110,indent:1,string:"meghal anélkül, hogy a kapocs megsemmisülne,",params:[]),(code:20110,indent:1,string:"a tárgy MINDENKI által használhatatlanná",params:[]),(code:20110,indent:1,string:"válik, és semmilyen módszerrel nem lehet",params:[]),(code:20110,indent:1,string:"megszüntetni a szétszakadt lélekkapcsot!",params:[]),(code:10110,indent:1,string:"Az egyetlen lehetséges felbontása a",params:[]),(code:20110,indent:1,string:"Lélekkapocsnak:",params:[]),(code:20110,indent:1,string:"A lélekpárnak fennhangon ki kell mondani a",params:[]),(code:20110,indent:1,string:"kapocsmegszüntető szavakat.",params:[]),(code:10110,indent:1,string:"A szavak:",params:[]),(code:20110,indent:1,string:"Fithos, Lusec, Wecos, Vinosec\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Ezeket a szavakat mondta Tif",params:[]),(code:20110,indent:1,string:"a trónteremben...\"",params:[]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Most nem érdekel",params:[1]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:11,x:16,y:5,name:"EV0011",pages:[(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'Az Aeropolis tervei\'\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"A könyv egy furcsa, csillag alakú",params:[]),(code:20110,indent:0,string:"zárral le van pecsételve...\"",params:[]),(code:12010,indent:0,string:"",params:[4,201,0,0,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Esetleg... A csillagtárgy mintha",params:[]),(code:20110,indent:1,string:"beleillene...\"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:11550,indent:1,string:"Key",params:[90,100,50]),(code:10110,indent:1,string:"**\\N[1] kinyitotta a könyvzárat!**",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Beleolvasok/Most nem érdekel",params:[2]),(code:20140,indent:1,string:"Beleolvasok",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"\"Az Anti-gravitációs Emelő megalkotásával",params:[]),(code:20110,indent:2,string:"lehetőségünk nyílt arra, hogy ne csak szellemileg,",params:[]),(code:20110,indent:2,string:"de fizikailag is a primitív emberek fölé",params:[]),(code:20110,indent:2,string:"emelkedjünk. Már folynak az előkészületek az",params:[]),(code:10110,indent:2,string:"Égi Város megépítéséhez. A központi épület a",params:[]),(code:20110,indent:2,string:"Gran kastély lesz, ez alá már be is szereltük a",params:[]),(code:20110,indent:2,string:"levegőbe emeléshez szükséges eszközöket.",params:[]),(code:20110,indent:2,string:"A többit majd folyamatosan, már a levegőben",params:[]),(code:10110,indent:2,string:"fogjuk mellé építeni, amint szépen sokasodunk.",params:[]),(code:20110,indent:2,string:"Már nem kell sokáig lent élnünk az aljanép,",params:[]),(code:20110,indent:2,string:"az emberek között.\"",params:[]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most nem érdekel",params:[1]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:12110,indent:1,string:"",params:[100]),(code:10210,indent:1,string:"",params:[0,609,609,0]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:false,skippable:false),layer:1,condition:(flags:1,switch_a:609,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"\'Az Aeropolis tervei\'\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Beleolvasok/Most nem érdekel",params:[2]),(code:20140,indent:0,string:"Beleolvasok",params:[0]),(code:11550,indent:1,string:"Key",params:[90,100,50]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"\"Az Anti-gravitációs Emelő megalkotásával",params:[]),(code:20110,indent:1,string:"lehetőségünk nyílt arra, hogy ne csak szellemileg,",params:[]),(code:20110,indent:1,string:"de fizikailag is a primitív emberek fölé",params:[]),(code:20110,indent:1,string:"emelkedjünk. Már folynak az előkészületek az",params:[]),(code:10110,indent:1,string:"Égi Város megépítéséhez. A központi épület a",params:[]),(code:20110,indent:1,string:"Gran kastély lesz, ez alá már be is szereltük a",params:[]),(code:20110,indent:1,string:"levegőbe emeléshez szükséges eszközöket.",params:[]),(code:20110,indent:1,string:"A többit majd folyamatosan, már a levegőben",params:[]),(code:10110,indent:1,string:"fogjuk mellé 