ing:"\"Hadd nézzem csak...\"",params:[]),(code:10110,indent:1,string:"Férfi",params:[]),(code:20110,indent:1,string:"\"Á, a Vadász Egylet tagja! Természetesen magának",params:[]),(code:20110,indent:1,string:"ingyenes a belépés... Kellemes vadászatot!",params:[]),(code:11330,indent:1,string:"",params:[10005,8,0,0,3,3,3,13]),(code:11410,indent:1,string:"",params:[8]),(code:10210,indent:1,string:"",params:[0,592,592,0]),(code:10210,indent:1,string:"",params:[0,538,538,0]),(code:10,indent:1,string:"",params:[]),(code:22010,indent:0,string:"",params:[]),(code:10220,indent:1,string:"",params:[0,11,11,0,7,0,0]),(code:12010,indent:1,string:"",params:[1,11,0,500,1,1]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Rendben/Most inkább mégse...",params:[2]),(code:20140,indent:2,string:"Rendben",params:[0]),(code:10310,indent:3,string:"",params:[1,0,500]),(code:11550,indent:3,string:"Holy1",params:[90,150,50]),(code:10130,indent:3,string:"",params:[0,0,0]),(code:10110,indent:3,string:"\\N[1] kifizette az 500GP-t!",params:[]),(code:10110,indent:3,string:"Férfi",params:[]),(code:20110,indent:3,string:"\"Köszönöm! Kellemes vadászatot!\"",params:[]),(code:11330,indent:3,string:"",params:[10005,8,0,0,3,3,3,13]),(code:11410,indent:3,string:"",params:[8]),(code:10210,indent:3,string:"",params:[0,537,537,0]),(code:10210,indent:3,string:"",params:[0,538,538,0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most inkább mégse...",params:[1]),(code:10130,indent:3,string:"",params:[0,0,0]),(code:10110,indent:3,string:"Férfi",params:[]),(code:20110,indent:3,string:"\"Pedig nem bánná meg...\"",params:[]),(code:10130,indent:3,string:"Ron",params:[6,0,0]),(code:10110,indent:3,string:"\\N[1]",params:[]),(code:20110,indent:3,string:"\"Majd legközelebb...\"",params:[]),(code:11330,indent:3,string:"",params:[10001,8,0,0,2]),(code:11410,indent:3,string:"",params:[3]),(code:11520,indent:3,string:"",p