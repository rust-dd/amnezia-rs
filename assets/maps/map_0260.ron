..\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Ha egy ilyen helyen entert nyomsz, akkor rögtön",params:[]),(code:20110,indent:0,string:"bejön a mentőmenü, nem kell bemásznod külön",params:[]),(code:20110,indent:0,string:"a főmenübe...\"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:13,x:3,y:8,name:"EV0013",pages:[(trigger:0,graphic_name:"Chara1",graphic_index:6,direction:1,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:12010,indent:0,string:"",params:[0,581,0,0,0,0]),(code:10110,indent:1,string:"Férfi",params:[]),(code:20110,indent:1,string:"\"Ismételjem meg?\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Igen/Nem",params:[2]),(code:20140,indent:1,string:"Igen",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Nem",params:[1]),(code:12120,indent:2,string:"",params:[1]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"A kalandod során sokszor kell majd vásárolnod",params:[]),(code:20110,indent:0,string:"valamilyen tárgyakat ahhoz, hogy továbbjuthass.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"A gyógyító tárgyak a következők:",params:[]),(code:20110,indent:0,string:"Gyógyital, Extra gyógyital, Alma, Mézkörte\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"A frissítő tárgyak a következők:",params:[]),(code:20110,indent:0,string:"Ke-ran dió, Kiu-ran dió, Koe-ran dió\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"A mérget az Antitoxin-nal tudod eltávolítani",params:[]),(code:20110,indent:0,string:"a szervezetedből.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Felélesztésre az Életital szolgál.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Ezeket a tárgyakat mindenki használhatja, de",params:[]),(code:20110,indent:0,string:"a fegyverek/páncélok terén már más a helyzet.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"Minden karakter különböző fegyvereket/páncélokat",params:[]),(code:20110,indent:0,string:"tud használni. Az, hogy ki mit, az az alábbi módon",params:[]),(code:20110,indent:0,string:"derül ki a boltban:\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Ha az adott tárgy használható egy karakter által,",params:[]),(code:20110,indent:0,string:"akkor oldalt a karakter képe színes és sétál, ha",params:[]),(code:20110,indent:0,string:"nem, akkor pedig fekete-fehér és egy helyben áll.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Ezen belül ha a karakter melett egy kis felfelé",params:[]),(code:20110,indent:0,string:"mutató nyíl van, akkor a tárgy jobb, mint az",params:[]),(code:20110,indent:0,string:"éppen használt, ha lefelé mutat, akkor rosszabb.\"",params:[]),(code:10110,indent:0,string:"Férfi",params:[]),(code:20110,indent:0,string:"\"Ha esetleg egy pont van a karakter mellett, akkor",params:[]),(code:20110,indent:0,string:"se nem jobb, se nem rosszabb.\"",params:[]),(code:10210,indent:0,string:"",params:[0,581,581,0]),(code:12110,indent:0,string:"",params:[1]),(code:0,indent:0,string:"",params:[])])]),(id:14,x:4,y:4,name:"EV0014",pages:[(trigger:0,graphic_name:"Torch",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:4,move_route:(commands:[],repeat:true