,(code:20110,indent:0,string:"\"Átkutattam a kastélyt, de nem",params:[]),(code:20110,indent:0,string:"találtam senkit... Te jutottál",params:[]),(code:20110,indent:0,string:"valamire?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Sajnos még nem...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Viszont lenne egy-két",params:[]),(code:20110,indent:0,string:"kérdésem...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Hadd halljam!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Ha helyes az elméleted, és",params:[]),(code:20110,indent:0,string:"tényleg egy őrült áll minden",params:[]),(code:20110,indent:0,string:"mögött, akkor...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Akkor?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Miért mással hozatta ide a",params:[]),(code:20110,indent:0,string:"nyakláncot évekkel ezelőtt?\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Miért nem ő maga hozta el?\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Ezen én is gondolkodtam már...\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Talán azért, mert akkor éppen",params:[]),(code:20110,indent:0,string:"valahol tartózkodott, és nem",params:[]),(code:20110,indent:0,string:"tudott eljönni rögtön...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hmmm... Elképzelhető...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Vagy... Vagy egy faluban lakott,",params:[]),(code:20110,indent:0,string:"és nem akarta, hogy a falubeliek",params:[]),(code:20110,indent:0,string:"megtudják, hogy ki ő.\"",params:[]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Az a baj, hogy ezek mind-mind",params:[]),(code:20110,indent:0,string:"csak elméletek, találgatások...\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Na ja. Nem baj, legalább adtál",params:[]),(code:20110,indent:0,string:"egy-két ötletet...\"",params:[]),(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Igen? Örülök... Ha jutsz valamire,",params:[]),(code:20110,indent:0,string:"akkor szólj!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Oké.\"",params:[]),(code:10210,indent:0,string:"",params:[0,441,441,0]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"Chara2",graphic_index:2,direction:0,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:441,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Stark",params:[1,0,0]),(code:10110,indent:0,string:"Stark",params:[]),(code:20110,indent:0,string:"\"Na? Valami fejlemény?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Semmi...\"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,directio