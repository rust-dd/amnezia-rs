tring:"",params:[20]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Mit néz rajtam annyira?\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,28,26,24,0,2,25,27,29,15]),(code:11410,indent:0,string:"",params:[5]),(code:10130,indent:0,string:"Ron",params:[5,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Ööö... Izé... Semmit...\"",params:[]),(code:11330,indent:0,string:"",params:[10001,8,0,0,13]),(code:11410,indent:0,string:"",params:[1]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Csak valahonnan nagyon ismerős",params:[]),(code:20110,indent:0,string:"nekem...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[0,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Ron, mi lenne, ha tegeződnénk?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[7,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Nagyon örülnék neki!\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[0,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Akkor ezt megbeszéltük. Egyébként...\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Te is nagyon ismerős vagy nekem.",params:[]),(code:20110,indent:0,string:"Honnan származol?\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Sajnos nem emlékszem... 3 éve történt",params:[]),(code:20110,indent:0,string:"velem valami, amitől elveszítettem az",params:[]),(code:20110,indent:0,string:"emlékezetem...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Nem emlékszem a múltamból",params:[]),(code:20110,indent:0,string:"semmire... Nem tudom hol születtem,",params:[]),(code:20110,indent:0,string:"kik voltak a szüleim...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Csoda, hogy a nevemet nem",params:[]),(code:20110,indent:0,string:"felejtettem el...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Ez érdekes... Velem majdhogynem",params:[]),(code:20110,indent:0,string:"ugyanez a helyzet!\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Hogy-hogy???\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Én is elvesztettem az emlékezetem",params:[]),(code:20110,indent:0,string:"valamitől, de a kórházban, ahol",params:[]),(code:20110,indent:0,string:"felébredtem, elmondtak mindent.\"",params:[]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Sternből származom, de 3 éve",params:[]),(code:20110,indent:0,string:"lerombolták. Valószínűleg ott ért",params:[]),(code:20110,indent:0,string:"valamilyen megrázkódtatás.\"",params:[]),(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"3 éve??? Micsoda véletlen",params:[]),(code:20110,indent:0,string:"egybeesés...\"",params:[]),(code:10130,indent:0,string:"Tiffany",params:[3,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Ja...\"",params:[]),(code:11410,indent:0,string:"",params:[10]),(code:11520,indent:0,string:"",params:[3000]),(code:10130,indent:0,string:"Tiffany",params:[0,0,0]),(code:10110,indent:0,string:"Tiffany",params:[]),(code:20110,indent:0,string:"\"Hallgasd csak! Azt hiszem lassan",params:[]),(code:20110,indent:0,string:"eláll az eső...\"