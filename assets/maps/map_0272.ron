ms:[]),(code:22010,indent:0,string:"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Üres...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"... Várjunk csak... Mintha...\"",params:[]),(code:11550,indent:1,string:"Boxopen",params:[90,100,50]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Igen! Kettős üreg van az alján!",params:[]),(code:20110,indent:1,string:"Na lássuk, mit rejt a titkos üreg...\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Egy... Napló...?\"",params:[]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Belelapozok/Most nem érdekel",params:[2]),(code:20140,indent:1,string:"Belelapozok",params:[0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1424. 113. nap",params:[]),(code:20110,indent:2,string:"\"Úgy döntöttem, hogy életemet a tudománynak",params:[]),(code:20110,indent:2,string:"szentelem, és így elkezdek naplót vezetni. Nem",params:[]),(code:20110,indent:2,string:"hiszem, hogy nagyon sűrűn fogok beleírni, de",params:[]),(code:10110,indent:2,string:"minden jelentősebb felfedezésemet lejegyzem,",params:[]),(code:20110,indent:2,string:"hogy ha én már nem leszek, akkor az utókor is",params:[]),(code:20110,indent:2,string:"tanuljon az esetleges hibáimból.\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1424. 201. nap",params:[]),(code:20110,indent:2,string:"\"Tribal... Ez a név már régóta motoszkál a",params:[]),(code:20110,indent:2,string:"fejemben... Kik voltak ők? Miért nem maradt fent",params:[]),(code:20110,indent:2,string:"róluk semmi? Miért tűntek el? Hiszen ők voltak",params:[]),(code:10110,indent:2,string:"az előttünk élő civilizáció emberei. Vagy ez az",params:[]),(code:20110,indent:2,string:"információ is téves? Szinte semmit se tudunk",params:[]),(code:20110,indent:2,string:"róluk... Ezen változtatni fogok!\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1425. 52. nap",params:[]),(code:20110,indent:2,string:"\"SEMMI... Semmi nem maradt fennt a Tribalokról.",params:[]),(code:20110,indent:2,string:"Senki nem tud semmit, csak azt, hogy előttünk",params:[]),(code:20110,indent:2,string:"éltek, és már meghaltak mind. De miért nem találok",params:[]),(code:10110,indent:2,string:"róluk semmit? Nem adom fel!\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10210,indent:2,string:"",params:[0,613,613,0]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1425. 94. nap",params:[]),(code:20110,indent:2,string:"\"IGEN! Végre találtam egy ősrégi kódexet (jó",params:[]),(code:20110,indent:2,string:"sokat fizettem érte...), mely minimális említést",params:[]),(code:20110,indent:2,string:"tesz a Tribalokról. De milyen említést...?",params:[]),(code:10110,indent:2,string:"Tribal = Gran kastély a Stern szigeten",params:[]),(code:20110,indent:2,string:"Ennyi. Se több, se kevesebb... Muszáj elmennem",params:[]),(code:20110,indent:2,string:"abba a kastélyba, talán ott találok valamit... Ha",params:[]),(code:20110,indent:2,string:"egyáltalán áll még az a rom...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1425. 112. nap",params:[]),(code:20110,indent:2,string:"\"Nem olyan könnyű a dolgom, mint gondoltam...",params:[]),(code:20110,indent:2,string:"A kastélyba lehetetlen bejutni, a kapukat",params:[]),(code:20110,indent:2,string:"semmilyen módszerrel nem tudtam kinyitni.",params:[]),(code:10110,indent:2,string:"És a csapdák... Mi lehet odabent...? Mi az, amit",params:[]),(code:20110,indent:2,string:"még most is őriznek a falak...? Valahogy be kell",params:[]),(code:20110,indent:2,string:"jutnom! És már van is ötletem, hogy hogyan...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1425. 116. nap",params:[]),(code:20110,indent:2,string:"\"Istenem... Ez nem lehet... Maga a pokol van",params:[]),(code:20110,indent:2,string:"készülőben odabent! Muszáj megsemmisítenem",params:[]),(code:20110,indent:2,string:"az ébredésmedált! De hogyan...?\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1425. 201. nap",params:[]),(code:20110,indent:2,string:"\"Esélytelen... Képtelen vagyok bármivel is kárt",params:[]),(code:20110,indent:2,string:"tenni a medálban... Egyelőre muszáj félretennem,",params:[]),(code:20110,indent:2,string:"hogy a többi problémával is foglalkozhassak, de ez",params:[]),(code:10110,indent:2,string:"nem maradhat így. Muszáj valami megoldást",params:[]),(code:20110,indent:2,string:"találnom... Valamikor visszamegyek a kastélyba,",params:[]),(code:20110,indent:2,string:"hátha ott találok valamit, ami hasznomra lehet.\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1425. 205. nap",params:[]),(code:20110,indent:2,string:"\"Ma voltam a kastélyban... Borzalmas volt...",params:[]),(code:20110,indent:2,string:"Egész idő alatt éreztem, hogy nem vagyok egyedül.",params:[]),(code:20110,indent:2,string:"hogy valaki FIGYELI minden mozdulatomat...",params:[]),(code:10110,indent:2,string:"És az egyik tartály... ÜRES volt... Lehet, hogy",params:[]),(code:20110,indent:2,string:"hiba volt elvenni a medált... De ha otthagyom,",params:[]),(code:20110,indent:2,string:"akkor talán még borzalmasabb sors vár a világra...",params:[]),(code:20110,indent:2,string:"Muszáj megsemmisítenem!\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1426. 72. nap",params:[]),(code:20110,indent:2,string:"\"Megvan a megoldás... Bármily szörnyű is, csak",params:[]),(code:20110,indent:2,string:"ez az egyetlen lehetőség... A Lélekkapocs...",params:[]),(code:20110,indent:2,string:"Holnap neki is kezdek az előkészületeknek...",params:[]),(code:10110,indent:2,string:"És utána... Jöhet az örök sötétség...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:10140,indent:2,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:2,string:"Továbblapozok",params:[0]),(code:10,indent:3,string:"",params:[]),(code:20140,indent:2,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:3,string:"",params:[100]),(code:10,indent:3,string:"",params:[]),(code:20141,indent:2,string:"",params:[]),(code:10130,indent:2,string:"",params:[0,0,0]),(code:10110,indent:2,string:"T.I. 1426. 82. nap",params:[]),(code:20110,indent:2,string:"\"Rám talált... Most már értem, miért volt üres a",params:[]),(code:20110,indent:2,string:"tartály... De már csak 4 óra, és kész a",params:[]),(code:20110,indent:2,string:"Lélekkapocs... Ha nem készül el...",params:[]),(code:10110,indent:2,string:"Isten óvjon mindannyiunkat...\"",params:[]),(code:10130,indent:2,string:"Ron",params:[6,0,0]),(code:10110,indent:2,string:"\\N[1]",params:[]),(code:20110,indent:2,string:"\"Itt véget ér a napló...",params:[]),(code:20110,indent:2,string:"Hátborzongató...\"",params:[]),(code:10210,indent:2,string:"",params:[0,614,614,0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most nem érdekel",params:[1]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:12110,indent:1,string:"",params:[100]),(code:10210,indent:1,string:"",params:[0,604,604,0]),(code:10,indent:1,string:"",params:[]),(code:22011,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"Object1",graphic_index:6,direction:3,pattern:1,animation_type:4,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:1,switch_a:604,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Belelapozok a naplóba/Most inkább nem",params:[2]),(code:20140,indent:0,string:"Belelapozok a naplóba",params:[0]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"T.I. 1424. 113. nap",params:[]),(code:20110,indent:1,string:"\"Úgy döntöttem, hogy életemet a tudománynak",params:[]),(code:20110,indent:1,string:"szentelem, és így elkezdek naplót vezetni. Nem",params:[]),(code:20110,indent:1,string:"hiszem, hogy nagyon sűrűn fogok beleírni, de",params:[]),(code:10110,indent:1,string:"minden jelentősebb felfedezésemet lejegyzem,",params:[]),(code:20110,indent:1,string:"hogy ha én már nem leszek, akkor az utókor is",params:[]),(code:20110,indent:1,string:"tanuljon az esetleges hibáimból.\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"T.I. 1424. 201. nap",params:[]),(code:20110,indent:1,string:"\"Tribal... Ez a név már régóta motoszkál a",params:[]),(code:20110,indent:1,string:"fejemben... Kik voltak ők? Miért nem maradt fent",params:[]),(code:20110,indent:1,string:"róluk semmi? Miért tűntek el? Hiszen ők voltak",params:[]),(code:10110,indent:1,string:"az előttünk élő civilizáció emberei. Vagy ez az",params:[]),(code:20110,indent:1,string:"információ is téves? Szinte semmit se tudunk",params:[]),(code:20110,indent:1,string:"róluk... Ezen változtatni fogok!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1