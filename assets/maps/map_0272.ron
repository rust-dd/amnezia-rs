[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"T.I. 1425. 112. nap",params:[]),(code:20110,indent:1,string:"\"Nem olyan könnyű a dolgom, mint gondoltam...",params:[]),(code:20110,indent:1,string:"A kastélyba lehetetlen bejutni, a kapukat",params:[]),(code:20110,indent:1,string:"semmilyen módszerrel nem tudtam kinyitni.",params:[]),(code:10110,indent:1,string:"És a csapdák... Mi lehet odabent...? Mi az, amit",params:[]),(code:20110,indent:1,string:"még most is őriznek a falak...? Valahogy be kell",params:[]),(code:20110,indent:1,string:"jutnom! És már van is ötletem, hogy hogyan...\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"T.I. 1425. 116. nap",params:[]),(code:20110,indent:1,string:"\"Istenem... Ez nem lehet... Maga a pokol van",params:[]),(code:20110,indent:1,string:"készülőben odabent! Muszáj megsemmisítenem",params:[]),(code:20110,indent:1,string:"az ébredésmedált! De hogyan...?\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"T.I. 1425. 201. nap",params:[]),(code:20110,indent:1,string:"\"Esélytelen... Képtelen vagyok bármivel is kárt",params:[]),(code:20110,indent:1,string:"tenni a medálban... Egyelőre muszáj félretennem,",params:[]),(code:20110,indent:1,string:"hogy a többi problémával is foglalkozhassak, de ez",params:[]),(code:10110,indent:1,string:"nem maradhat így. Muszáj valami megoldást",params:[]),(code:20110,indent:1,string:"találnom... Valamikor visszamegyek a kastélyba,",params:[]),(code:20110,indent:1,string:"hátha ott találok valamit, ami hasznomra lehet.\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"T.I. 1425. 205. nap",params:[]),(code:20110,indent:1,string:"\"Ma voltam a kastélyban... Borzalmas volt...",params:[]),(code:20110,indent:1,string:"Egész idő alatt éreztem, hogy nem vagyok egyedül.",params:[]),(code:20110,indent:1,string:"hogy valaki FIGYELI minden mozdulatomat...",params:[]),(code:10110,indent:1,string:"És az egyik tartály... ÜRES volt... Lehet, hogy",params:[]),(code:20110,indent:1,string:"hiba volt elvenni a medált... De ha otthagyom,",params:[]),(code:20110,indent:1,string:"akkor talán még borzalmasabb sors vár a világra...",params:[]),(code:20110,indent:1,string:"Muszáj megsemmisítenem!\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"T.I. 1426. 72. nap",params:[]),(code:20110,indent:1,string:"\"Megvan a megoldás... Bármily szörnyű is, csak",params:[]),(code:20110,indent:1,string:"ez az egyetlen lehetőség... A Lélekkapocs...",params:[]),(code:20110,indent:1,string:"Holnap neki is kezdek az előkészületeknek...",params:[]),(code:10110,indent:1,string:"És utána... Jöhet az örök sötétség...\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:10140,indent:1,string:"Továbblapozok/Most ennyi elég volt",params:[2]),(code:20140,indent:1,string:"Továbblapozok",params:[0]),(code:10,indent:2,string:"",params:[]),(code:20140,indent:1,string:"Most ennyi elég volt",params:[1]),(code:12120,indent:2,string:"",params:[100]),(code:10,indent:2,string:"",params:[]),(code:20141,indent:1,string:"",params:[]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:10110,indent:1,string:"T.I. 1426. 82. nap",params:[]),(code:20110,indent:1,string:"\"Rám talált... Most már értem, miért volt üres a",params:[]),(code:20110,indent:1,string:"tartály... De már csak 4 óra, és kész a",params:[]),(code:20110,indent:1,string:"Lélekkapocs... Ha nem készül el...",params:[]),(code:10110,indent:1,string:"Isten óvjon mindannyiunkat...\"",params:[]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Itt véget ér a napló...",params:[]),(code:20110,indent:1,string:"Hátborzongató...\"",params:[]),(code:10210,indent:1,string:"",params:[0,614,614,0]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Most inkább nem",params:[1]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:12110,indent:0,string:"",params:[100]),(code:0,indent:0,string:"",params:[])])]),(id:18,x:9,y:9,name:"EV0018",pages:[(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repeat:true,skippable:false),layer:1,condition:(flags:0,switch_a:0,switch_b:0,variable_id:0,variable_value:0,item_id:0,actor_id:1),commands:[(code:10130,indent:0,string:"Ron",params:[6,0,0]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Össze van zúzva a koponyája...",params:[]),(code:20110,indent:0,string:"Meggyilkolták...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:20110,indent:0,string:"\"Mintha lenne valami a nyakában.",params:[]),(code:20110,indent:0,string:"Egy csillag alakú tárgy...\"",params:[]),(code:10110,indent:0,string:"\\N[1]",params:[]),(code:10140,indent:0,string:"Elveszem/Ott hagyom",params:[2]),(code:20140,indent:0,string:"Elveszem",params:[0]),(code:10130,indent:1,string:"",params:[0,0,0]),(code:11550,indent:1,string:"Item",params:[90,100,50]),(code:10110,indent:1,string:"Ron talált egy csillagtárgyat!",params:[]),(code:10320,indent:1,string:"",params:[0,0,201,0,1]),(code:10130,indent:1,string:"Ron",params:[6,0,0]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Ez vajon mi lehet...?\"",params:[]),(code:10210,indent:1,string:"",params:[0,607,607,0]),(code:10,indent:1,string:"",params:[]),(code:20140,indent:0,string:"Ott hagyom",params:[1]),(code:10110,indent:1,string:"\\N[1]",params:[]),(code:20110,indent:1,string:"\"Ne háborgassuk a holtakat...\"",params:[]),(code:10210,indent:1,string:"",params:[0,608,608,0]),(code:10,indent:1,string:"",params:[]),(code:20141,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])]),(trigger:0,graphic_name:"",graphic_index:0,direction:2,pattern:1,move_type:0,move_frequency:3,move_speed:3,move_route:(commands:[],repea