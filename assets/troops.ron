ds:[(code:10130,indent:0,string:"Monsters",params:[15,0,0]),(code:10110,indent:0,string:"Démonlord",params:[]),(code:20110,indent:0,string:"\"Végre egy kis testmozgás...\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:0,indent:0,string:"",params:[])])]),(id:50,name:"Harcos oktat",members:[(enemy_id:42,x:160,y:96)],pages:[(condition:(flags:8,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:0,turn_b:0,fatigue_min:0,fatigue_max:100,enemy_index:0,enemy_hp_min:0,enemy_hp_max:100,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:13110,indent:0,string:"",params:[0,0,0,9999,0]),(code:10130,indent:0,string:"People2",params:[7,0,0]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"No. A harc körökből áll, és minden",params:[]),(code:20110,indent:0,string:"kör elején el kell döntened, hogy",params:[]),(code:20110,indent:0,string:"mit csinálsz.\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Harc - Újabb menüt nyit meg 4 féle",params:[]),(code:20110,indent:0,string:"választási lehetőséggel.\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"Autoharc - Az adott körben a gép",params:[]),(code:20110,indent:0,string:"cselekszik helyetted, nem kell neked",params:[]),(code:20110,indent:0,string:"kiválasztani a parancsokat.\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Menekülés - Megpróbálsz meglógni",params:[]),(code:20110,indent:0,string:"az adott csatából. Ez a főszörnyeken",params:[]),(code:20110,indent:0,string:"kívül többnyire mindig sikerül is...\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:0,indent:0,string:"",params:[])]),(condition:(flags:8,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:0,turn_b:2,fatigue_min:0,fatigue_max:100,enemy_index:0,enemy_hp_min:0,enemy_hp_max:100,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:13110,indent:0,string:"",params:[0,0,0,9999,0]),(code:10130,indent:0,string:"People2",params:[7,0,0]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"A harc menü első pontja a \'Támadás\'.",params:[]),(code:20110,indent:0,string:"Ha ezt választod, akkor a karakter",params:[]),(code:20110,indent:0,string:"megtámadja a választott ellenfelet.\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Ha a támadás sikeres, akkor",params:[]),(code:20110,indent:0,string:"az áldozat valamennyi HP-t veszít,",params:[]),(code:20110,indent:0,string:"ami 0-ra csökkenve halált jelent.\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Ez ugyanígy a karakterekre is",params:[]),(code:20110,indent:0,string:"érvényes!\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"A HP-k gyógyitalokkal és",params:[]),(code:20110,indent:0,string:"gyümölcsökkel téríthetők vissza.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:0,indent:0,string:"",params:[])]),(condition:(flags:8,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:0,turn_b:3,fatigue_min:0,fatigue_max:100,enemy_index:0,enemy_hp_min:0,enemy_hp_max:100,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:13110,indent:0,string:"",params:[0,0,0,9999,0]),(code:10130,indent:0,string:"People2",params:[7,0,0]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"A második pont mindenkinek",params:[]),(code:20110,indent:0,string:"a speciális technikáit jelzi. Neked",params:[]),(code:20110,indent:0,string:"például \'Pengetánc\'.\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Ezek a támadások jóval erősebbek",params:[]),(code:20110,indent:0,string:"mint az alaptámadás, viszont",params:[]),(code:20110,indent:0,string:"kifárasztanak!\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"A fáradságodat SP-kben számoljuk,",params:[]),(code:20110,indent:0,string:"és ha elfogynak az SP-id, akkor nem",params:[]),(code:20110,indent:0,string:"tudsz ilyen technikát használni!\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Az SP-k visszatéríthetők a",params:[]),(code:20110,indent:0,string:"különböző diókkal.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:0,indent:0,string:"",params:[])]),(condition:(flags:8,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:0,turn_b:4,fatigue_min:0,fatigue_max:100,enemy_index:0,enemy_hp_min:0,enemy_hp_max:100,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:13110,indent:0,string:"",params:[0,0,0,9999,0]),(code:10130,indent:0,string:"People2",params:[7,0,0]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"A harmadik pont a \'Védekezés\'.\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Amelyik karakter védekezik, az",params:[]),(code:20110,indent:0,string:"a várható sebzésnek csak a felét",params:[]),(code:20110,indent:0,string:"szenvedi el az adott körben.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:0,indent:0,string:"",params:[])]),(condition:(flags:8,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:0,turn_b:5,fatigue_min:0,fatigue_max:100,enemy_index:0,enemy_hp_min:0,enemy_hp_max:100,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:13110,indent:0,string:"",params:[0,0,0,9999,0]),(code:10130,indent:0,string:"People2",params:[7,0,0]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Az utolsó pont a \'Tárgy\'. Ezzel",params:[]),(code:20110,indent:0,string:"tudod használni a különböző",params:[]),(code:20110,indent:0,string:"HP/SP-visszatérítő cuccokat.\"",params:[]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"Vigyázz, mert ha a tárgyhasználó",params:[]),(code:20110,indent:0,string:"karakter meghal tárgyhasználat előtt,",params:[]),(code:20110,indent:0,string:"akkor nem tudja használni a cuccot!\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:0,indent:0,string:"",params:[])]),(condition:(flags:8,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:0,turn_b:6,fatigue_min:0,fatigue_max:100,enemy_index:0,enemy_hp_min:0,enemy_hp_max:100,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:13110,indent:0,string:"",params:[0,0,0,9999,0]),(code:10130,indent:0,string:"People2",params:[7,0,0]),(code:10110,indent:0,string:"Harcos",params:[]),(code:20110,indent:0,string:"\"No, lényegében ennyi.\"",params:[]),(code:10130,indent:0,string:"",params:[0,0,0]),(code:13410,indent:0,string:"",params:[]),(code:0,indent:0,string:"",params:[])])]),(id:51,name:"Utolso harc2",members:[(enemy_id:43,x:156,y:100),(enemy_id:26,x:116,y:88),(enemy_id:27,x:196,y:88),(enemy_id:28,x:156,y:100)],pages:[(condition:(flags:8,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:0,turn_b:0,fatigue_min:0,fatigue_max:100,enemy_index:0,enemy_hp_min:0,enemy_hp_max:0,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:10210,indent:0,string:"",params:[0,616,616,0]),(code:0,indent:0,string:"",params:[])]),(condition:(flags:40,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:1,turn_b:1,fatigue_min:0,fatigue_max:100,enemy_index:3,enemy_hp_min:1,enemy_hp_max:100,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:10110,indent:0,string:"A Szonda teljesen feljavítja a lélekőrt!",params:[]),(code:13110,indent:0,string:"",params:[0,0,0,3000,0]),(code:0,indent:0,string:"",params:[])]),(condition:(flags:32,switch_a_id:1,switch_b_id:1,variable_id:1,variable_value:0,turn_a:0,turn_b:0,fatigue_min:0,fatigue_max:100,enemy_index:1,enemy_hp_min:0,enemy_hp_max:0,actor_id:1,actor_hp_min:0,actor_hp_max:100),commands:[(code:10210,indent:0,string:"",p